                        title: '1. 原始版段 (GPIO BSRR 800kHz 時序脈衝)',
                        code: `/* USER CODE BEGIN PV */
uint32_t led_colors_buff[3] = { 0 };
/* USER CODE END PV */

/* Private function prototypes */
static void MX_TIM6_Init(void);
static void MX_GPIO_Init(void);

/* USER CODE BEGIN PFP */
void ws2812b_display_all_led_colors(uint32_t *buff);
void ws2812b_set_colors(uint32_t grb);
/* USER CODE END PFP */

/* USER CODE BEGIN 2 */
led_colors_buff[0] = 0x0f0000;
led_colors_buff[1] = 0x000f00;
led_colors_buff[2] = 0xffffff;
HAL_TIM_Base_Start_IT(&htim6);
/* USER CODE END 2 */

/* USER CODE BEGIN 4 */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim6) {
    ws2812b_display_all_led_colors(led_colors_buff);
}

void ws2812b_set_colors(uint32_t grb) {
    uint_fast32_t ns;
    uint_fast32_t mask = 0x00800000; // start from the highest bit
    for (uint_fast8_t i = 0; i < 24; i++) { // 24 bits
        if (grb & mask) { // *** bit 1 ***
            RGB_DATA_GPIO_Port->BSRR = RGB_DATA_Pin; // 800 ns (ns = 13)
            while (ns--) asm("nop");
            RGB_DATA_GPIO_Port->BRR = RGB_DATA_Pin; // 450 ns (ns = 5)
            while (ns--) asm("nop");
        } else { // *** bit 0 ***
            RGB_DATA_GPIO_Port->BSRR = RGB_DATA_Pin; // 400 ns (ns = 6)
            while (ns--) asm("nop");
            RGB_DATA_GPIO_Port->BRR = RGB_DATA_Pin; // 850 ns (ns = 12)
            while (ns--) asm("nop");
        }
        mask >>= 1;
    }
}

void ws2812b_display_all_led_colors(uint32_t *buff) {
    for (uint8_t i = 0; i < 3; i++) {
        ws2812b_set_colors(buff[i]);
    }
}
/* USER CODE END 4 */`
                    },
