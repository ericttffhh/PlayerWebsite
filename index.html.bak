                        <input type="text" class="form-input" id="editCompletionTime"
                            placeholder="例如：111年11月28日 17:30 (耗時 4.0 小時)">
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label">📷 作品照片 (開啟 Google 雲端硬碟/本機選取視窗)</label>
                        <div style="margin-bottom:0.75rem;">
                            <button type="button" class="btn btn-gold" id="openEditPickerBtn"
                                style="padding:0.6rem 1.4rem; font-size:0.9rem;">
                                📂 開啟 Google 雲端硬碟 / 本機圖片選取視窗
                            </button>
                        </div>
                        <div class="file-dropzone" id="editFileDropzoneBox"
                            onclick="document.getElementById('editImageFile').click();">
                            <p style="color:var(--text-muted); font-size:0.85rem;">
                                點擊選擇本機照片 (可複選多張，系統自動進行壓縮優化) 或將圖片拖曳至此
                            </p>
                            <input type="file" id="editImageFile" accept="image/*" multiple style="display:none;">
                            <div id="editImagePreviewContainer"
                                style="display:flex; flex-wrap:wrap; gap:0.4rem; justify-content:center; margin-top:0.5rem;">
                            </div>
                        </div>
                        <textarea class="form-textarea" id="editImage" placeholder="或在此貼上 Google 雲端硬碟圖片網址 (可貼上多張，每行一張)"
                            style="min-height:65px; margin-top:0.4rem;"></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label">🎬 YouTube 功能展示影片網址</label>
                        <input type="url" class="form-input" id="editYoutubeUrl"
                            placeholder="貼上完整YouTube網址，例如 https://www.youtube.com/watch?v=dQw4w9WgXcQ (留空則不顯示播放器)">
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label">📝 作品與技術描述</label>
                        <textarea class="form-textarea" id="editDescription" required></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label">💭 練習心得與檢討</label>
                        <textarea class="form-textarea" id="editReflections"></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label">💬 指導老師評語 (變更將即時寫入回傳 Google 試算表)</label>
                        <textarea class="form-textarea" id="editFeedback" placeholder="寫下指導老師評語與建議 (若無請留空)..."
                            style="min-height:85px;"></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label"
                            style="display:flex; justify-content:space-between; align-items:center;">
                            <span>👨‍💻 C/C++ 程式碼區塊 (支援新增多段程式碼，標題可自訂編輯)</span>
                            <button type="button" class="btn btn-outline" id="addEditSnippetBtn"
                                style="padding:0.35rem 0.85rem; font-size:0.82rem; color:var(--accent-green); border-color:var(--accent-green);">
                                ➕ 新增一段程式碼
                            </button>
                        </label>
                        <div id="editSnippetsContainer" class="snippets-editor-container"></div>
                    </div>

                    <div class="form-group full-width">
                        <label class="form-label">🎯 評分明細項目</label>
                        <input type="text" class="form-input" id="editRubric">
                    </div>
                </div>

                <div style="display:flex; justify-content:flex-end; gap:1rem; margin-top:1.25rem;">
                    <button type="submit" class="btn btn-gold" style="padding:0.75rem 2rem;">
                        💾 儲存評分/評語與多段程式碼
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 🎯 Google Sites 風格與 Google Drive API 選取圖片 Modal -->
    <div class="modal-overlay" id="drivePickerModalOverlay">
        <div class="picker-modal-container">
            <div class="picker-header">
                <div style="display:flex; align-items:center; gap:0.5rem;">
                    <span style="font-size:1.2rem;">📂</span>
                    <span class="picker-title">選取圖片 (Google Drive API)</span>
                </div>
                <div class="picker-search-bar">
                    <input type="text" class="picker-search-input" id="pickerSearchInput"
                        placeholder="在雲端硬碟中搜尋或貼上網址...">
                </div>
                <button class="modal-close-btn" id="pickerCloseBtn"
                    style="position:static; background:transparent; color:#5f6368;">✕</button>
            </div>

            <div class="picker-tabs-bar">
                <button class="picker-tab-btn active" id="pickerTabDrive">Google 雲端硬碟</button>
                <button class="picker-tab-btn" id="pickerTabLink">連結 (URL)</button>
                <button class="picker-tab-btn" id="pickerTabLocal">本機上傳</button>
            </div>

            <div class="picker-body" id="pickerViewDrive">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
                    <div style="font-size:0.88rem; font-weight:700; color:#5f6368;">近期的作品照片與雲端相簿 (點擊勾選照片)</div>
                    <button class="btn btn-outline" id="launchOfficialGooglePickerBtn"
                        style="padding:0.35rem 0.85rem; font-size:0.8rem; color:#1a73e8; border-color:#1a73e8;">
                        🌐 呼叫 Google 官方 Drive 雲端硬碟視窗
                    </button>
                </div>
                <div class="picker-grid" id="pickerPhotoGrid"></div>
            </div>

            <div class="picker-body" id="pickerViewLink" style="display:none;">
                <div style="font-size:0.9rem; color:#3c4043; margin-bottom:0.75rem;">請貼上 Google 雲端硬碟圖片分享連結或圖片網址
                    (多張請以逗號或換行分隔)：</div>
                <textarea class="form-textarea" id="pickerLinkTextarea"
                    placeholder="https://drive.google.com/file/d/XXXXX/view?usp=sharing"
                    style="background:#f8f9fa; border:1px solid #dadce0; color:#202124; min-height:160px; font-size:0.9rem;"></textarea>
            </div>

            <div class="picker-body" id="pickerViewLocal" style="display:none;">
                <div style="font-size:0.9rem; color:#3c4043; margin-bottom:0.75rem;">選擇本機照片 (自動壓縮優化，發佈時上傳至 Google 雲端硬碟)：
                </div>
                <input type="file" id="pickerLocalFileInput" accept="image/*" multiple style="margin-top:0.5rem;">
            </div>

            <div class="picker-footer">
                <button class="btn btn-outline" id="pickerCancelBtn"
                    style="border-color:#dadce0; color:#3c4043;">取消</button>
                <button class="btn btn-primary" id="pickerConfirmBtn"
                    style="background:#1a73e8; color:#fff; border-radius:4px; padding:0.5rem 1.5rem;">
                    確認選取照片
                </button>
            </div>
        </div>
    </div>

    
        <!-- 💾 資料備份與還原 Modal (JSON Backup & Restore) -->
        <div class="modal-overlay" id="backupModalOverlay">
            <div class="modal-container" style="max-width:620px;">
                <button class="modal-close-btn" id="backupModalClose">✕</button>
                <h3 style="margin-bottom:1rem; color:var(--accent-cyan); display:flex; align-items:center; gap:0.5rem;">
                    <span>💾</span> 資料備份與還原管理 (JSON)
                </h3>
                <p style="color:var(--text-muted); font-size:0.88rem; line-height:1.6; margin-bottom:1.25rem;">
                    因系統設計為<strong>單一 HTML 檔案</strong>以利內嵌於協作平台中，所有自訂成果皆儲存於瀏覽器本地。建議您定期匯出 JSON 備份檔，或將備份匯入以跨電腦同步。
                </p>

                <div style="display:flex; flex-direction:column; gap:1rem;">
                    <!-- 匯出 -->
                    <div class="hero-banner" style="padding:1.25rem; margin-bottom:0;">
                        <div style="font-weight:700; color:var(--accent-green); margin-bottom:0.4rem; display:flex; align-items:center; gap:0.4rem;">
                            <span>📥</span> 匯出完整備份檔 (Download JSON)
                        </div>
                        <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:0.75rem;">
                            將目前的全部作品、多段程式碼、焊接照片網址、心得與指導老師評語打包下載為單一 JSON 檔案。
                        </p>
                        <button class="btn btn-primary" id="exportJsonBtn" style="width:100%; justify-content:center;">
                            📥 立即下載備份檔 (.json)
                        </button>
                    </div>

                    <!-- 匯入 -->
                    <div class="hero-banner" style="padding:1.25rem; margin-bottom:0;">
                        <div style="font-weight:700; color:var(--accent-cyan); margin-bottom:0.4rem; display:flex; align-items:center; gap:0.4rem;">
                            <span>📤</span> 匯入歷史備份檔 (Restore from JSON)
                        </div>
                        <p style="font-size:0.82rem; color:var(--text-muted); margin-bottom:0.75rem;">
                            選取先前備份的 JSON 檔案，系統將自動解析並載入所有訓練成果。
                        </p>
                        <div style="display:flex; gap:0.75rem; align-items:center;">
                            <input type="file" id="importJsonFileInput" accept=".json,application/json" style="display:none;">
                            <button class="btn btn-outline" id="selectJsonFileBtn" style="flex:1; justify-content:center;">
                                📂 選擇 JSON 備份檔案
                            </button>
                            <select id="importModeSelect" class="form-select" style="width:130px; padding:0.5rem; font-size:0.82rem;">
                                <option value="replace">覆蓋現有紀錄</option>
                                <option value="merge">合併現有紀錄</option>
                            </select>
                        </div>
                        <div id="importFileStatus" style="font-size:0.8rem; color:var(--text-muted); margin-top:0.5rem;">尚未選取檔案</div>
                    </div>

                    <!-- 原廠重設 -->
                    <div style="display:flex; justify-content:space-between; align-items:center; padding-top:0.5rem;">
                        <span style="font-size:0.8rem; color:var(--text-muted);">欲回到系統初始示範紀錄？</span>
                        <button class="btn btn-outline" id="resetDefaultBtn" style="color:var(--accent-red); border-color:var(--accent-red); font-size:0.8rem; padding:0.35rem 0.75rem;">
                            ⚠️ 重設為原廠預設
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-overlay" id="googleModalOverlay">
        <div class="modal-container" style="max-width:700px;">
            <button class="modal-close-btn" id="googleModalClose">✕</button>
            <h3 style="margin-bottom:1rem; color:var(--accent-cyan);">🔗 Google 協作平台 (Google Sites) 嵌入教學</h3>
            <p style="color:var(--text-muted); font-size:0.9rem; margin-bottom:1rem;">
                請複製下方 HTML 嵌入碼，前往您的 **Google 協作平台編輯器**，點選右側面板「嵌入 (Embed) -> 嵌入程式碼 (Embed code)」，貼上即可將本系統放入協作平台中！
            </p>

            <pre class="code-block" id="googleEmbedSnippet"
                style="margin-bottom:1.25rem; white-space:pre-wrap; word-break:break-all;"></pre>

            <div style="display:flex; justify-content:flex-end; gap:1rem;">
                <button class="btn btn-primary" id="copyEmbedSnippetBtn">
                    📋 複製 HTML 嵌入碼
                </button>
            </div>
        </div>
    </div>

    <div class="toast-container" id="toastContainer"></div>

    <script>
        /* ==========================================================================
           Ericqw 選手訓練成果紀錄系統 - Core Data Store & Google Drive Image Parser
           ========================================================================== */

        const STORAGE_KEY = 'ericqw_athlete_records_v7';
