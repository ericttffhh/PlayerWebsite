void Start_ADC_DMA_Sampling(uint32_t *buffer, uint16_t length) {
    ADC1->CR2 |= ADC_CR2_DMA | ADC_CR2_DDS;
    DMA2_Stream0->NDTR = length;
    DMA2_Stream0->M0AR = (uint32_t)buffer;
    DMA2_Stream0->CR |= DMA_SxCR_EN;
    ADC1->CR2 |= ADC_CR2_SWSTART;
}`
                    },
                    {
                        title: '2. ARM DSP FFT 頻譜計算與 Vpp 頻率解析',
                        code: `/* ARM DSP Math Library FFT Processing */
void Calculate_FFT_Spectrum(float32_t *input, float32_t *output, uint16_t fftSize) {
    arm_rfft_fast_instance_f32 S;
    arm_rfft_fast_init_f32(&S, fftSize);
    arm_rfft_fast_f32(&S, input, output, 0);
    arm_cmplx_mag_f32(output, input, fftSize / 2);
    
    uint32_t maxIndex = 0;
    float32_t maxValue = 0;
    arm_max_f32(input, fftSize / 2, &maxValue, &maxIndex);
    float signal_freq = (float)maxIndex * 100000.0f / fftSize;
}`
                    }
