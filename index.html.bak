char Scan_Keypad_Matrix(void) {
    for (int row = 0; row < 4; row++) {
        HAL_GPIO_WritePin(KEY_ROW_PORT, row_pins[row], GPIO_PIN_RESET);
        for (int col = 0; col < 4; col++) {
            if (HAL_GPIO_ReadPin(KEY_COL_PORT, col_pins[col]) == GPIO_PIN_RESET) {
                HAL_Delay(10);
                return Key_Table[row][col];
            }
        }
        HAL_GPIO_WritePin(KEY_ROW_PORT, row_pins[row], GPIO_PIN_SET);
    }
    return 0;
}`
