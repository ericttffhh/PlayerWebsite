    float p_acc = atan2(-ax, sqrt(ay*ay + az*az)) * 57.2958f;
    float r_acc = atan2(ay, az) * 57.2958f;
    pitch = 0.96f * (pitch + gx * dt) + 0.04f * p_acc;
    roll  = 0.96f * (roll + gy * dt)  + 0.04f * r_acc;
}`,
