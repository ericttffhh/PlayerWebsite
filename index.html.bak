                        title: '2. DMA 區段 (TIM PWM + DMA 傳輸優化)',
                        code: `/* WS2812B TIM PWM DMA 雙緩衝發送 */
void WS2812B_DMA_Send(uint32_t *colors, uint16_t len) {
    static uint16_t pwm_buf[24 * 3 + 50];
    uint32_t idx = 0;
    for (int i = 0; i < len; i++) {
        uint32_t grb = colors[i];
        for (int b = 23; b >= 0; b--) {
            pwm_buf[idx++] = (grb & (1 << b)) ? WS2812_BIT_1 : WS2812_BIT_0;
        }
    }
    HAL_TIM_PWM_Start_DMA(&htim2, TIM_CHANNEL_1, (uint32_t*)pwm_buf, idx);
}`
                    }
