th%3D%222%22%20%2F%3E%03C%2Fsvg%3E";

        // 使用者提供的真實 Google Drive 照片網址
        const DRIVE_PHOTO_1 = "https://lh3.googleusercontent.com/d/1xSzE0hG2r94ulPJdelBn1ky3SUYpaSYn";
        const DRIVE_PHOTO_2 = "https://lh3.googleusercontent.com/d/17_ecCpsBHLXEFZ0vC6UYb3UM3N-b8ZRY";

        function parseSingleUrl(url) {
            if (!url || typeof url !== 'string') return '';
            const trimmed = url.trim();
            if (!trimmed) return '';

            const driveRegex = /(?:file\/d\/|id=|d\/)([a-zA-Z0-9_-]{25,})/;
            const match = trimmed.match(driveRegex);
            if (match && match[1]) {
                return `https://lh3.googleusercontent.com/d/${match[1]}`;
            }
            if (trimmed.includes('assets/images/soldering_project')) return DRIVE_PHOTO_1;
            if (trimmed.includes('assets/images/stm32_project')) return DRIVE_PHOTO_2;
            return trimmed;
        }

        function convertGoogleDriveImageUrl(rawInput) {
            if (!rawInput) return [];
            if (Array.isArray(rawInput)) {
                return rawInput.map(u => parseSingleUrl(u)).filter(Boolean);
            }
            const str = String(rawInput).trim();
            if (!str) return [];

            if (str.includes(',') || str.includes('\n')) {
                return str.split(/[\n,]+/).map(p => parseSingleUrl(p)).filter(Boolean);
            }
            const single = parseSingleUrl(str);
            return single ? [single] : [];
        }

        /**
         * 👨‍💻 智慧 C/C++ 程式碼自動排版與縮排器 (C-Style Code Formatter)
         * 當程式碼未分行或遭壓縮時，自動將分號、大括號、註解開頭拆解為標準多行 C/C++ 程式碼。
         */
        /**
 * 🛡️ XSS 字串安全轉義函式 (HTML Sanitizer)
 */
function escapeHTML(str) {
    if (str === null || str === undefined) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

/**
 * 👨‍💻 C/C++ 核心語法高科技色彩標記器 (Lightweight C/C++ Syntax Highlighter)
 * 支援嵌入式常見型別 (STM32, FreeRTOS, CMSIS)、十六進位暫存器值、巨集指令與字串
 */
function highlightCCode(code) {
    if (!code || typeof code !== 'string') return '';
    let safe = code
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

    const tokens = [];
    const addToken = (html) => {
        tokens.push(html);
        return `___CC_TOK_${tokens.length - 1}___`;
    };

    // 1. 註解 (多行與單行)
    safe = safe.replace(/(\/\*[\s\S]*?\*\/|\/\/[^\n]*)/g, (m) => addToken(`<span class="c-comment">${m}</span>`));
    // 2. 字串與字元字面量
    safe = safe.replace(/("(\\"|[^"])*"|'(\\'|[^'])*')/g, (m) => addToken(`<span class="c-string">${m}</span>`));
    // 3. 巨集與前置處理指令
    safe = safe.replace(/(#[a-zA-Z_]\w*)/g, (m) => addToken(`<span class="c-macro">${m}</span>`));
    // 4. 十六進位與數字
    safe = safe.replace(/\b(0x[0-9a-fA-F]+|\d+(?:\.\d+)?(?:[eE][+-]?\d+)?f?)\b/g, (m) => addToken(`<span class="c-number">${m}</span>`));
    // 5. C/C++ 核心關鍵字
    const keywords = /\b(void|int|char|short|long|float|double|signed|unsigned|struct|union|enum|typedef|sizeof|static|volatile|const|extern|register|auto|return|if|else|switch|case|default|while|do|for|break|continue|goto|inline|restrict|bool|true|false|NULL)\b/g;
    safe = safe.replace(keywords, (m) => addToken(`<span class="c-keyword">${m}</span>`));
    // 6. 嵌入式常見型別 (STM32, FreeRTOS, CMSIS)
    const embedTypes = /\b(uint8_t|uint16_t|uint32_t|uint64_t|int8_t|int16_t|int32_t|int64_t|size_t|GPIO_TypeDef|TIM_TypeDef|USART_TypeDef|ADC_TypeDef|DMA_TypeDef|RCC_TypeDef|NVIC_InitTypeDef|GPIO_InitTypeDef|TIM_TimeBaseInitTypeDef|BaseType_t|TaskHandle_t)\b/g;
    safe = safe.replace(embedTypes, (m) => addToken(`<span class="c-type">${m}</span>`));
    // 7. 函式呼叫
    safe = safe.replace(/\b([a-zA-Z_]\w*)(?=\s*\()/g, (m) => addToken(`<span class="c-func">${m}</span>`));

    // 還原 Tokens
    safe = safe.replace(/___CC_TOK_(\d+)___/g, (_, idx) => tokens[Number(idx)]);
    return safe;
}

window.escapeHTML = escapeHTML;
window.highlightCCode = highlightCCode;

function formatCStyleCode(code) {
            if (!code || typeof code !== 'string') return '';
            let str = code.trim();
            if (!str) return '';

            // 如果原本已經是有換行格式的程式碼 (換行數 > 4)，直接回傳
            const existingLines = str.split('\n');
            if (existingLines.length > 4) {
                return str;
            }

            // 針對單行擠壓的 C/C++ 程式碼進行自動斷行與縮排處理
            str = str
                .replace(/\/\*/g, '\n/*')
                .replace(/\*\//g, '*/\n')
                .replace(/;\s*/g, ';\n')
                .replace(/\{\s*/g, '{\n')
                .replace(/\}\s*/g, '\n}\n');

            const rawLines = str.split('\n');
            const cleanLines = [];
            let indentLevel = 0;
            const indentStr = '    ';

            rawLines.forEach(line => {
                let trimmed = line.trim();
                if (!trimmed) return;

                if (trimmed.startsWith('}')) {
                    indentLevel = Math.max(0, indentLevel - 1);
                }

                const currentIndent = indentStr.repeat(indentLevel);
                cleanLines.push(currentIndent + trimmed);

                if (trimmed.endsWith('{')) {
                    indentLevel++;
                }
            });

            return cleanLines.join('\n');
        }

        /**
         * ⚡ 解析與標準化項目的多段程式碼 (Multi Code Snippets Normalizer)
         */
        function getRecordCodeSnippets(r) {
            if (!r) return [];
            let list = [];
            if (r.codeSnippets && Array.isArray(r.codeSnippets) && r.codeSnippets.length > 0) {
                list = r.codeSnippets.filter(s => s && (s.title || s.code));
            } else if (r.codeSnippet && typeof r.codeSnippet === 'string' && r.codeSnippet.trim()) {
                try {
                    const parsed = JSON.parse(r.codeSnippet);
                    if (Array.isArray(parsed) && parsed.length > 0 && parsed[0].title) {
                        list = parsed;
                    }
                } catch (e) { }
                if (list.length === 0) {
                    list = [{ title: '主程式與核心邏輯', code: r.codeSnippet.trim() }];
                }
            }

            return list.map(item => ({
                title: item.title || '程式碼片段',
                code: formatCStyleCode(item.code || '')
            }));
        }

        /**
         * ⚡ 圖片自動畫布壓縮引擎 (Canvas Image Auto-Compressor)
         */
        function compressImageFile(file, maxWidth = 900, maxHeight = 900, quality = 0.75) {
            return new Promise((resolve) => {
                if (!file || !file.type.startsWith('image/')) {
                    resolve('');
                    return;
                }
                const reader = new FileReader();
                reader.onload = (e) => {
                    const img = new Image();
                    img.onload = () => {
                        let width = img.width;
                        let height = img.height;

                        if (width > maxWidth || height > maxHeight) {
                            if (width > height) {
                                height = Math.round((height * maxWidth) / width);
                                width = maxWidth;
                            } else {
                                width = Math.round((width * maxHeight) / height);
                                height = maxHeight;
                            }
                        }

                        const canvas = document.createElement('canvas');
                        canvas.width = width;
                        canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);

                        const compressedDataUri = canvas.toDataURL('image/jpeg', quality);
                        resolve(compressedDataUri);
                    };
                    img.onerror = () => resolve(e.target.result);
                    img.src = e.target.result;
                };
                reader.onerror = () => resolve('');
                reader.readAsDataURL(file);
            });
        }

