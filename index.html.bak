                    options: ['A) 2 A', 'B) 4 A', 'C) 6 A', 'D) 8 A'],
                    answerIndex: 2,
                    explanation: '並聯等效電阻 Req = (6 * 3) / (6 + 3) = 2Ω。總電流 I = V / Req = 12V / 2Ω = 6A。'
                }
            ]
        };

        function formatDateString(rawDate) {
            if (!rawDate) return new Date().toISOString().slice(0, 10);
            const d = new Date(rawDate);
            if (!isNaN(d.getTime())) {
                const yyyy = d.getFullYear();
                const mm = String(d.getMonth() + 1).padStart(2, '0');
                const dd = String(d.getDate()).padStart(2, '0');
                return `${yyyy}-${mm}-${dd}`;
            }
            return String(rawDate).slice(0, 10);
        }

        class DataManager {
            static getRecords() {
                const saved = localStorage.getItem(STORAGE_KEY);
                let records = INITIAL_RECORDS;
                if (saved) {
                    try {
                        records = JSON.parse(saved);
                    } catch (e) {
                        console.error('Failed to parse saved records, loading initial:', e);
                        records = INITIAL_RECORDS;
                    }
                }
                return records.map(r => {
                    const convertedImgs = convertGoogleDriveImageUrl(r.images || r.image);
                    const snippets = getRecordCodeSnippets(r);
                    return {
                        ...r,
                        status: r.status || '已完工',
                        image: convertedImgs.length > 0 ? convertedImgs[0] : '',
                        images: convertedImgs,
                        codeSnippets: snippets,
                        codeSnippet: snippets.length > 0 ? JSON.stringify(snippets) : (r.codeSnippet || ''),
                        date: formatDateString(r.date)
                    };
                });
            }

            static saveRecords(records) {
                const cleaned = records.map(r => {
                    const convertedImgs = convertGoogleDriveImageUrl(r.images || r.image);
                    const snippets = getRecordCodeSnippets(r);
                    return {
                        ...r,
                        status: r.status || '已完工',
                        image: convertedImgs.length > 0 ? convertedImgs[0] : '',
                        images: convertedImgs,
                        codeSnippets: snippets,
                        codeSnippet: snippets.length > 0 ? JSON.stringify(snippets) : (r.codeSnippet || ''),
                        date: formatDateString(r.date)
                    };
                });
                try {
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(cleaned));
                } catch (err) {
                    console.warn('LocalStorage quota limit warning:', err);
                }
            }

            static addRecord(newRecord) {
                const records = this.getRecords();
                const convertedImgs = convertGoogleDriveImageUrl(newRecord.images || newRecord.image);
                const snippets = getRecordCodeSnippets(newRecord);

                const fullRecord = {
                    id: 'user-' + Date.now(),
                    status: newRecord.status || '已完工',
                    year: new Date().getFullYear() - 1911 + '年',
                    completionTime: newRecord.completionTime || (formatDateString(newRecord.date) + ' (完工)'),
                    date: formatDateString(newRecord.date),
                    image: convertedImgs.length > 0 ? convertedImgs[0] : '',
                    images: convertedImgs,
                    codeSnippets: snippets,
                    codeSnippet: snippets.length > 0 ? JSON.stringify(snippets) : (newRecord.codeSnippet || ''),
                    youtubeUrl: newRecord.youtubeUrl || '',
                    score: newRecord.score || '',
                    feedback: newRecord.feedback || '',
                    tags: newRecord.tags ? (Array.isArray(newRecord.tags) ? newRecord.tags : newRecord.tags.split(',').map(t => t.trim())) : ['作品紀錄'],
                    ...newRecord
                };
                records.unshift(fullRecord);
                this.saveRecords(records);

                // 🚀 即時 POST 寫入 Google 試算表
                this.sendPostToGoogleSheets('add', fullRecord);
                return fullRecord;
            }

            static updateRecord(id, updatedFields) {
                const records = this.getRecords();
                const index = records.findIndex(r => r.id === id);
                if (index !== -1) {
                    if (updatedFields.images || updatedFields.image) {
                        const convertedImgs = convertGoogleDriveImageUrl(updatedFields.images || updatedFields.image);
                        updatedFields.images = convertedImgs;
                        updatedFields.image = convertedImgs.length > 0 ? convertedImgs[0] : '';
                    }
                    if (updatedFields.codeSnippets) {
                        const snippets = getRecordCodeSnippets(updatedFields);
                        updatedFields.codeSnippets = snippets;
                        updatedFields.codeSnippet = snippets.length > 0 ? JSON.stringify(snippets) : '';
                    }
                    records[index] = { ...records[index], ...updatedFields };
                    this.saveRecords(records);

                    // 🚀 即時 POST 同步更新至 Google 試算表
                    this.sendPostToGoogleSheets('update', records[index]);
                    return records[index];
                }
                return null;
            }

            static async sendPostToGoogleSheets(action, record) {
                const scriptUrl = this.getSavedGoogleScriptUrl();
                if (!scriptUrl) return;
                try {
                    await fetch(scriptUrl, {
                        method: 'POST',
                        mode: 'no-cors',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: action, data: record })
                    });
                    console.log(`[GoogleSheets Sync] Successfully sent ${action} request to Google Sheets.`);
                } catch (err) {
                    console.warn('[GoogleSheets Sync] POST error:', err);
                }
            }

            static resetToDefault() {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(INITIAL_RECORDS));
                return INITIAL_RECORDS;
            }

            static async syncFromGoogleSheets(scriptUrl) {
                if (!scriptUrl) scriptUrl = DEFAULT_SCRIPT_URL;
                try {
                    localStorage.setItem(GOOGLE_SCRIPT_URL_KEY, scriptUrl);
                    const res = await fetch(scriptUrl);
                    const text = await res.text();

                    if (text.includes('<!DOCTYPE html>') || text.includes('google.com/accounts') || text.includes('AccountChooser')) {
                        return { error: 'PERMISSION_DENIED', message: 'Apps Script 部署存取權限尚未設為「任何人 (Anyone)」。請至 Apps Script 點選「管理部署」➔ 修改存取權限為「任何人」。' };
                    }

                    const data = JSON.parse(text);
                    if (Array.isArray(data)) {
                        if (data.length > 0) {
                            const parsedData = data.map(item => {
                                const convertedImgs = convertGoogleDriveImageUrl(item.images || item.image);
                                const snippets = getRecordCodeSnippets(item);
                                return {
                                    ...item,
                                    status: item.status || '已完工',
                                    image: convertedImgs.length > 0 ? convertedImgs[0] : '',
                                    images: convertedImgs,
                                    codeSnippets: snippets,
                                    codeSnippet: snippets.length > 0 ? JSON.stringify(snippets) : (item.codeSnippet || '')
                                };
                            });
                            this.saveRecords(parsedData);
                            return { success: true, count: parsedData.length, records: parsedData };
                        } else {
                            return { error: 'EMPTY_DATA', message: '連線成功！但試算表中目前無有效資料或欄位尚未設定內容。' };
                        }
                    }
                } catch (err) {
                    console.warn('Google Sheets sync notice:', err);
                    return { error: 'FETCH_ERROR', message: '網路連線失敗或 Web App 網址無效。' };
                }
                return { error: 'UNKNOWN_ERROR', message: '無法解析 Google 試算表回傳之資料。' };
            }

            static getSavedGoogleScriptUrl() {
                return localStorage.getItem(GOOGLE_SCRIPT_URL_KEY) || DEFAULT_SCRIPT_URL;
            }
        }

        window.DataManager = DataManager;
        window.QUIZ_BANK = QUIZ_BANK;
        window.formatDateString = formatDateString;
        window.convertGoogleDriveImageUrl = convertGoogleDriveImageUrl;
        window.compressImageFile = compressImageFile;
        window.formatCStyleCode = formatCStyleCode;
        window.getRecordCodeSnippets = getRecordCodeSnippets;
        window.DRIVE_PHOTO_1 = DRIVE_PHOTO_1;
        window.DRIVE_PHOTO_2 = DRIVE_PHOTO_2;
        window.SVG_SOLDERING_HERO = SVG_SOLDERING_HERO;
        window.SVG_STM32_DEMO = SVG_STM32_DEMO;


        /* ==========================================================================
           Ericqw 選手訓練成果紀錄系統 - Main UI Controller & Symbol Engine (Redesigned)
           ========================================================================== */

        document.addEventListener('DOMContentLoaded', () => {
            // 狀態變數
            let currentCategoryFilter = 'all';
            let currentSearchQuery = '';
            let currentSortBy = 'newest';
            let currentPage = 1;
            let currentSnakeFilter = 'all';
            const itemsPerPage = 6;

            // 上傳與編輯暫存的多張照片 (Data URIs)
            let uploadedDataUris = [];
            let editUploadedDataUris = [];

            // 上傳與編輯暫存的多段程式碼
            let uploadCodeSnippets = [];
            let editCodeSnippets = [];

            // Google 雲端硬碟圖片選取器狀態
            let activePickerTarget = 'upload'; // 'upload' 或 'edit'
            let selectedDrivePhotos = [];

            // 預設 Google 雲端硬碟圖庫 (含使用者提供的真實雲端硬碟相片)
            const GOOGLE_DRIVE_SAMPLE_PHOTOS = [
                { name: '焊接訓練封面照 (Drive)', url: window.DRIVE_PHOTO_1 || 'https://lh3.googleusercontent.com/d/1xSzE0hG2r94ulPJdelBn1ky3SUYpaSYn' },
                { name: 'STM32專案示範照 (Drive)', url: window.DRIVE_PHOTO_2 || 'https://lh3.googleusercontent.com/d/17_ecCpsBHLXEFZ0vC6UYb3UM3N-b8ZRY' },
                { name: 'soldering_project_hero.png', url: window.SVG_SOLDERING_HERO || '' },
                { name: 'stm32_project_demo.png', url: window.SVG_STM32_DEMO || '' },
                { name: 'IMG_3212.JPG', url: window.DRIVE_PHOTO_1 || '' },
                { name: 'IMG_3211.JPG', url: window.DRIVE_PHOTO_2 || '' },
                { name: 'IMG_3210.JPG', url: window.DRIVE_PHOTO_1 || '' },
                { name: 'IMG_3209.JPG', url: window.DRIVE_PHOTO_2 || '' },
                { name: 'IMG_3208.JPG', url: window.DRIVE_PHOTO_1 || '' },
                { name: 'IMG_3207.JPG', url: window.DRIVE_PHOTO_2 || '' }
            ];

            // Chart.js 實例
            let radarChartInstance = null;

            // 初始化 DOM 元件與監聽器
            initThemeToggle();
            initNavigation();
            initUploadForm();
            initEditForm();
            initModalListeners();
            initQuizModule();
            initDrivePickerModal();
            initGoogleAuth();
            initSnakeFilterButtons();
            initBackupManager();
            initPrintReport();
            initGlobalShortcuts();

            // 載入與渲染初始資料
            renderDashboard();
            renderProjectGrid();
            renderAnalyticsCharts();

            window.addEventListener('resize', () => {
                const analyticsView = document.getElementById('analyticsView');
                if (analyticsView && analyticsView.classList.contains('active')) {
                    renderSerpentineTimeline();
                }
            });

            // 🚀 一開機即自動抓取 Google 試算表最新數據 (Auto Sync on Boot)
            initGoogleSync(true);

            /* ==========================================================================
               1. 主題切換 (Theme Toggle)
               ========================================================================== */
            function initThemeToggle() {
                const themeBtn = document.getElementById('themeToggleBtn');
                const savedTheme = localStorage.getItem('ericqw_theme') || 'dark';
                document.documentElement.setAttribute('data-theme', savedTheme);
                updateThemeIcon(savedTheme);

                if (themeBtn) {
                    themeBtn.addEventListener('click', () => {
                        const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
                        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                        document.documentElement.setAttribute('data-theme', newTheme);
                        localStorage.setItem('ericqw_theme', newTheme);
                        updateThemeIcon(newTheme);
                        showToast(`已切換至 ${newTheme === 'dark' ? '深色科技' : '明亮簡約'} 主題`, 'success');
                        renderAnalyticsCharts();
                    });
                }
            }

            function updateThemeIcon(theme) {
                const themeBtn = document.getElementById('themeToggleBtn');
                if (themeBtn) {
                    themeBtn.innerHTML = theme === 'dark'
                        ? '<i class="fas font-icon">☀️</i>'
                        : '<i class="fas font-icon">🌙</i>';
                }
            }

            /* ==========================================================================
               2. 導覽分頁切換與搜尋排序
               ========================================================================== */
            function initNavigation() {
                const tabBtns = document.querySelectorAll('.tab-btn[data-tab]');
                tabBtns.forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const targetTab = btn.getAttribute('data-tab');
                        const filterCat = btn.getAttribute('data-filter') || 'all';
                        switchTab(targetTab, filterCat);
                    });
                });

                const searchInput = document.getElementById('globalSearchInput');
                const sortSelect = document.getElementById('sortSelect');
                const filterSelect = document.getElementById('categoryFilterSelect');
                const backBtn = document.getElementById('backToProjectsBtn');

                if (backBtn) {
                    backBtn.addEventListener('click', () => {
                        switchTab('projects', currentCategoryFilter);
                    });
                }

                if (searchInput) {
                    searchInput.addEventListener('input', (e) => {
                        currentSearchQuery = e.target.value.toLowerCase().trim();
                        currentPage = 1;
                        renderProjectGrid();
                    });
                }

                if (sortSelect) {
                    sortSelect.addEventListener('change', (e) => {
                        currentSortBy = e.target.value;
                        currentPage = 1;
                        renderProjectGrid();
                    });
                }

                if (filterSelect) {
                    filterSelect.addEventListener('change', (e) => {
                        currentCategoryFilter = e.target.value;
                        currentPage = 1;
                        renderProjectGrid();
                    });
                }

                const resetDataBtn = document.getElementById('resetDefaultDataBtn');
                if (resetDataBtn) {
                    resetDataBtn.addEventListener('click', () => {
                        if (confirm('確定要恢復預設範例紀錄嗎？您自行新增與編輯的紀錄將會重置。')) {
                            DataManager.resetToDefault();
                            showToast('已成功恢復系統預設訓練資料與真實照片！', 'success');
                            renderDashboard();
                            renderProjectGrid();
                            renderAnalyticsCharts();
                        }
                    });
                }

                const exportBtn = document.getElementById('exportDataBtn');
                if (exportBtn) {
                    exportBtn.addEventListener('click', () => {
                        const records = DataManager.getRecords();
                        const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(records, null, 2));
                        const dlAnchor = document.createElement('a');
                        dlAnchor.setAttribute("href", dataStr);
                        dlAnchor.setAttribute("download", `Ericqw_Athlete_Records_${new Date().toISOString().slice(0, 10)}.json`);
                        document.body.appendChild(dlAnchor);
                        dlAnchor.click();
                        dlAnchor.remove();
                        showToast('已匯出完整選手訓練資料備份！', 'success');
                    });
                }
            }

            function switchTab(tabId, categoryFilter = 'all') {
                const tabBtns = document.querySelectorAll('.tab-btn');
                const tabViews = document.querySelectorAll('.tab-view');

                tabBtns.forEach(btn => {
                    const btnTab = btn.getAttribute('data-tab');
                    const btnFilter = btn.getAttribute('data-filter') || 'all';

                    if (btnTab === tabId) {
                        if (tabId === 'projects') {
                            if (categoryFilter === 'all') {
                                btn.classList.add('active');
                            } else if (btnFilter === categoryFilter) {
                                btn.classList.add('active');
                            } else {
                                btn.classList.remove('active');
                            }
                        } else {
                            btn.classList.add('active');
                        }
                    } else {
                        btn.classList.remove('active');
                    }
                });

                tabViews.forEach(view => {
                    if (view.id === `${tabId}View`) {
                        view.classList.add('active');
                    } else {
                        view.classList.remove('active');
                    }
                });

                if (categoryFilter && tabId === 'projects') {
                    currentCategoryFilter = categoryFilter;
                    const select = document.getElementById('categoryFilterSelect');
                    if (select) select.value = categoryFilter;
                }

                if (tabId === 'projects') {
                    renderProjectGrid();
                } else if (tabId === 'analytics') {
                    renderAnalyticsCharts();
                }

                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            /* ==========================================================================
               3. 總覽 Dashboard 與 卡片 Symbol 渲染
               ========================================================================== */
            function renderDashboard() {
                const records = DataManager.getRecords();
                const totalCount = records.length;
                const solderingCount = records.filter(r => r.category === 'soldering').length;
                const stm32Count = records.filter(r => r.category === 'stm32').length;

                const totalCountEl = document.getElementById('dashTotalCount');
                const solderingCountEl = document.getElementById('dashSolderingCount');
                const stm32CountEl = document.getElementById('dashStm32Count');

                if (totalCountEl) totalCountEl.textContent = totalCount;
                if (solderingCountEl) solderingCountEl.textContent = solderingCount;
                if (stm32CountEl) stm32CountEl.textContent = stm32Count;

                const sImg = document.getElementById('dashSolderingImg');
                const mImg = document.getElementById('dashStm32Img');
                const url1 = window.DRIVE_PHOTO_1 || "https://lh3.googleusercontent.com/d/1xSzE0hG2r94ulPJdelBn1ky3SUYpaSYn";
                const url2 = window.DRIVE_PHOTO_2 || "https://lh3.googleusercontent.com/d/17_ecCpsBHLXEFZ0vC6UYb3UM3N-b8ZRY";

                if (sImg) {
                    sImg.src = url1;
                    sImg.onerror = () => { sImg.src = "https://drive.google.com/thumbnail?id=1xSzE0hG2r94ulPJdelBn1ky3SUYpaSYn&sz=w1000"; };
                }
                if (mImg) {
                    mImg.src = url2;
                    mImg.onerror = () => { mImg.src = "https://drive.google.com/thumbnail?id=17_ecCpsBHLXEFZ0vC6UYb3UM3N-b8ZRY&sz=w1000"; };
                }
            }

            function getYouTubeEmbedUrl(url) {
                if (!url || typeof url !== 'string') return '';
                const trimmed = url.trim();
                if (!trimmed) return '';

                const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
                const match = trimmed.match(regExp);
                if (match && match[2] && match[2].length === 11) {
                    return `https://www.youtube.com/embed/${match[2]}`;
                }
                return '';
            }

            function Symbol_ProjectCard(item) {
                const coverImage = (item.images && item.images.length > 0) ? item.images[0] : (item.image || '');
                const hasImage = coverImage && coverImage.trim() !== '' && !coverImage.includes('no-image');
                const formattedDate = window.formatDateString ? window.formatDateString(item.date) : String(item.date).slice(0, 10);
                const scoreDisplay = item.score ? `🎓 評分：${item.score}分` : '🎓 尚未評分';
                const photoCountBadge = (item.images && item.images.length > 1) ? `<span style="position:absolute; bottom:0.5rem; right:0.5rem; background:rgba(0,0,0,0.8); color:#fff; font-size:0.75rem; padding:0.2rem 0.5rem; border-radius:10px; z-index:4;">📷 ${item.images.length}張照片</span>` : '';

                const snippets = window.getRecordCodeSnippets ? window.getRecordCodeSnippets(item) : [];
                const codeBadgeText = snippets.length > 1 ? `👨‍💻 ${snippets.length}段程式碼` : '👨‍💻 Code';

                const isInProgress = item.status === '進行中' || item.status === '訓練中' || item.status === 'in_progress';
                const statusTagHtml = isInProgress
                    ? `<span style="font-weight:800; color:var(--accent-red); background:rgba(239,68,68,0.15); border:1px solid var(--accent-red); padding:0.15rem 0.6rem; border-radius:12px; font-size:0.78rem;">🔥 進行中</span>`
                    : `<span style="font-weight:700; color:var(--accent-green);">${item.status || '已完成'}</span>`;

                const headerHtml = hasImage ? `
      <div class="card-media">
        <img src="${coverImage}" alt="${item.title}" class="card-img" onerror="if(!this.dataset.tried){this.dataset.tried=1; var m=this.src.match(/\\/d\\/([a-zA-Z0-9_-]+)/); if(m) this.src='https://drive.google.com/thumbnail?id='+m[1]+'&sz=w1000'; else this.src=window.SVG_SOLDERING_HERO;} else { this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='none'; this.parentElement.classList.add('card-media-no-img'); var n=this.parentElement.querySelector('.no-img-title-wrapper'); if(n) n.style.display='block';}">
        <div class="card-media-overlay">
          <h3 class="card-title-on-image">${item.title}</h3>
        </div>
        <span class="card-badge badge-${item.category}">
          ${item.categoryName || (item.category === 'soldering' ? '焊接作品' : 'STM32作品')}
        </span>
        ${photoCountBadge}
        <div class="no-img-title-wrapper" style="display:none;">
          <h3 class="card-title-no-img">${item.title}</h3>
        </div>
      </div>
    ` : `
      <div class="card-media card-media-no-img">
        <span class="card-badge badge-${item.category}">
          ${item.categoryName || (item.category === 'soldering' ? '焊接作品' : 'STM32作品')}
        </span>
        <div class="no-img-title-wrapper">
          <h3 class="card-title-no-img">${item.title}</h3>
        </div>
      </div>
    `;

                return `
      <div class="project-card" data-id="${item.id}">
        ${headerHtml}
        <div class="card-body">
          <p class="card-desc">${item.description}</p>
          
          <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.82rem; margin-bottom:0.5rem;">
            <span style="color:var(--accent-cyan); font-weight:600;">⏱️ 完工時間：${item.completionTime || formattedDate}</span>
            <span style="color:var(--accent-amber); font-weight:800; font-size:0.9rem;">${scoreDisplay}</span>
          </div>

          <div class="tags-container">
            ${(item.tags || []).map(tag => `<span class="tag-pill">#${tag}</span>`).join('')}
          </div>

          <div class="card-meta">
            <span>📅 日期：${formattedDate}</span>
            ${statusTagHtml}
          </div>

          <div style="display: flex; gap: 0.5rem; margin-top: 1rem; flex-wrap:nowrap;">
            <button class="btn btn-primary view-detail-btn" style="flex:1.2; font-size:0.85rem;" data-id="${item.id}">🔍 查看詳情</button>
            <button class="btn btn-outline edit-record-btn" style="flex:1; font-size:0.85rem; color:var(--accent-amber);" data-id="${item.id}" title="打分/編輯">✏️ 編輯</button>
            ${snippets.length > 0 ? `<button class="btn btn-outline view-code-btn" style="flex:1.2; font-size:0.85rem; color:var(--accent-green);" data-id="${item.id}" title="查看多段程式碼">${codeBadgeText}</button>` : ''}
          </div>
        </div>
      </div>
    `;
            }

            function renderProjectGrid() {
                const gridContainer = document.getElementById('projectsCardsGrid');
                if (!gridContainer) return;

                let records = DataManager.getRecords();

                if (currentCategoryFilter !== 'all') {
                    records = records.filter(r => r.category === currentCategoryFilter);
                }

                if (currentSearchQuery) {
                    records = records.filter(r =>
                        r.title.toLowerCase().includes(currentSearchQuery) ||
                        r.description.toLowerCase().includes(currentSearchQuery) ||
                        (r.tags && r.tags.some(t => t.toLowerCase().includes(currentSearchQuery)))
                    );
                }

                records.sort((a, b) => {
                    if (currentSortBy === 'newest') return new Date(b.date) - new Date(a.date);
                    if (currentSortBy === 'oldest') return new Date(a.date) - new Date(b.date);
                    return 0;
                });

                const totalItems = records.length;
                const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;
                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                const startIndex = (currentPage - 1) * itemsPerPage;
                const paginatedRecords = records.slice(startIndex, startIndex + itemsPerPage);

                if (paginatedRecords.length === 0) {
                    gridContainer.innerHTML = `
        <div style="grid-column: 1/-1; text-align: center; padding: 3rem; color: var(--text-muted);">
          <div style="font-size: 3rem; margin-bottom: 1rem;">🔍</div>
          <h3>未找到符合條件的訓練成果紀錄</h3>
          <p style="margin-top: 0.5rem;">請嘗試調整搜尋關鍵字或分類條件，亦可點擊「上傳成果」新增新資料。</p>
        </div>
      `;
                } else {
                    gridContainer.innerHTML = paginatedRecords.map(item => Symbol_ProjectCard(item)).join('');
                }

                gridContainer.querySelectorAll('.view-detail-btn').forEach(btn => {
                    btn.addEventListener('click', () => openFullPageDetail(btn.getAttribute('data-id')));
                });
                gridContainer.querySelectorAll('.edit-record-btn').forEach(btn => {
                    btn.addEventListener('click', () => openEditModal(btn.getAttribute('data-id')));
                });
                gridContainer.querySelectorAll('.view-code-btn').forEach(btn => {
                    btn.addEventListener('click', () => openCodeModal(btn.getAttribute('data-id')));
                });

                renderPaginationControls(totalItems, totalPages);
            }

            function renderPaginationControls(totalItems, totalPages) {
                const paginationWrapper = document.getElementById('paginationWrapper');
                if (!paginationWrapper) return;

                if (totalItems <= itemsPerPage) {
                    paginationWrapper.style.display = 'none';
                    return;
                }

                paginationWrapper.style.display = 'flex';
                const infoEl = document.getElementById('paginationInfo');
                const numbersEl = document.getElementById('pageNumbers');

                const startItem = (currentPage - 1) * itemsPerPage + 1;
                const endItem = Math.min(currentPage * itemsPerPage, totalItems);

                if (infoEl) infoEl.textContent = `顯示第 ${startItem} - ${endItem} 筆，共 ${totalItems} 筆紀錄 (第 ${currentPage}/${totalPages} 頁)`;

                let pageBtnsHtml = `
      <button class="page-btn" id="prevPageBtn" ${currentPage === 1 ? 'disabled' : ''}>&lt;</button>
    `;

                for (let i = 1; i <= totalPages; i++) {
                    pageBtnsHtml += `
        <button class="page-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>
      `;
                }

                pageBtnsHtml += `
      <button class="page-btn" id="nextPageBtn" ${currentPage === totalPages ? 'disabled' : ''}>&gt;</button>
    `;

                if (numbersEl) {
                    numbersEl.innerHTML = pageBtnsHtml;
                    numbersEl.querySelectorAll('.page-btn[data-page]').forEach(btn => {
                        btn.addEventListener('click', () => {
                            currentPage = Number(btn.getAttribute('data-page'));
                            renderProjectGrid();
                            window.scrollTo({ top: 400, behavior: 'smooth' });
                        });
                    });

                    const prevBtn = document.getElementById('prevPageBtn');
                    const nextBtn = document.getElementById('nextPageBtn');

                    if (prevBtn) {
                        prevBtn.addEventListener('click', () => {
                            if (currentPage > 1) {
                                currentPage--;
                                renderProjectGrid();
                            }
                        });
                    }
                    if (nextBtn) {
                        nextBtn.addEventListener('click', () => {
                            if (currentPage < totalPages) {
                                currentPage++;
                                renderProjectGrid();
                            }
                        });
                    }
                }
            }

            /* ==========================================================================
               4. 整頁作品詳情頁 Symbol - 多圖與多段程式碼 (Multi-Code Snippet Engine)
               ========================================================================== */
            function openFullPageDetail(id) {
                const records = DataManager.getRecords();
                const item = records.find(r => r.id === id);
                if (!item) return;

                const container = document.getElementById('fullPageDetailContainer');
                if (!container) return;

                const embedVideoUrl = getYouTubeEmbedUrl(item.youtubeUrl);
                const photoList = (item.images && item.images.length > 0) ? item.images : (item.image ? [item.image] : []);
                const formattedDate = window.formatDateString ? window.formatDateString(item.date) : String(item.date).slice(0, 10);
                const teacherScoreText = item.score ? `${item.score} 分` : '尚未評分';
                const snippets = window.getRecordCodeSnippets ? window.getRecordCodeSnippets(item) : [];

                const isInProgress = item.status === '進行中' || item.status === '訓練中' || item.status === 'in_progress';
                const statusTextDisplay = isInProgress ? '🔥 進行中 (重點訓練中)' : (item.status || '已完工');

                let photoGalleryHtml = '';
                if (photoList.length > 0) {
                    if (photoList.length === 1) {
                        photoGalleryHtml = `
          <div class="hero-banner" style="padding:1.25rem;">
            <h3 style="color:var(--accent-cyan); margin-bottom:0.75rem; font-size:1.1rem;">📷 成果照片與電路圖</h3>
            <img src="${photoList[0]}" alt="${item.title}" style="width:100%; max-height:380px; object-fit:cover; border-radius:var(--radius-md); border:1px solid var(--border-color);" onerror="var m=this.src.match(/\\/d\\/([a-zA-Z0-9_-]+)/); if(m) this.src='https://drive.google.com/thumbnail?id='+m[1]+'&sz=w1000'; else this.src=window.SVG_SOLDERING_HERO;">
          </div>
        `;
                    } else {
                        photoGalleryHtml = `
          <div class="hero-banner" style="padding:1.25rem;">
            <h3 style="color:var(--accent-cyan); margin-bottom:0.75rem; font-size:1.1rem;">📷 成果照片藝廊 (共 ${photoList.length} 張照片)</h3>
            <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap:0.75rem;">
              ${photoList.map((imgUrl, idx) => `
                <div style="position:relative; cursor:pointer; overflow:hidden; border-radius:var(--radius-md); border:1px solid var(--border-color); height:130px; background:#000;" onclick="window.open('${imgUrl}', '_blank')">
                  <img src="${imgUrl}" alt="照片 ${idx + 1}" style="width:100%; height:100%; object-fit:cover; transition:transform 0.3s ease;" onerror="var m=this.src.match(/\\/d\\/([a-zA-Z0-9_-]+)/); if(m) this.src='https://drive.google.com/thumbnail?id='+m[1]+'&sz=w1000'; else this.src=window.SVG_SOLDERING_HERO;" onmouseover="this.style.transform='scale(1.08)'" onmouseout="this.style.transform='scale(1)'">
                  <span style="position:absolute; bottom:0.3rem; right:0.4rem; background:rgba(0,0,0,0.7); color:#fff; font-size:0.7rem; padding:0.1rem 0.4rem; border-radius:4px;">#${idx + 1}</span>
                </div>
              `).join('')}
            </div>
          </div>
        `;
                    }
                }

                // 渲染多段程式碼區塊 (Multi Code Snippets View)
                let multiCodeBlockHtml = '';
                if (snippets.length > 0) {
                    const tabsHtml = snippets.map((s, idx) => `
        <button class="code-tab-btn ${idx === 0 ? 'active' : ''}" data-index="${idx}">
          ${s.title || (`程式碼片段 #${idx + 1}`)}
        </button>
      `).join('');

                    multiCodeBlockHtml = `
        <div class="hero-banner" style="padding:1.5rem;">
          <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem; margin-bottom:0.75rem;">
            <h3 style="color:var(--accent-green); font-size:1.15rem; display:flex; align-items:center; gap:0.5rem;">
              <span>👨‍💻</span> C/C++ 核心演算法與中斷程式碼 (共 ${snippets.length} 段)
            </h3>
            <button class="btn btn-outline" id="copyActiveCodeBtn" style="padding:0.4rem 0.9rem; font-size:0.85rem; color:var(--accent-green); border-color:var(--accent-green);">
              📋 複製目前選取程式碼
            </button>
          </div>

          <div class="code-tab-nav" id="detailCodeTabNav">
            ${tabsHtml}
          </div>

          <pre class="code-block" id="detailCodeBlock" style="max-height:480px; overflow-x:auto; white-space:pre-wrap; word-wrap:break-word; font-family:'JetBrains Mono', monospace; font-size:0.88rem; line-height:1.65;"></pre>
        </div>
      `;
                }

                container.innerHTML = `
      <div style="max-width: 1200px; margin: 0 auto; padding-bottom: 2rem;">
        
        <!-- 頂部卡片 -->
        <div class="hero-banner" style="margin-bottom:1.5rem; padding:1.75rem;">
          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
            <div>
              <span class="card-badge badge-${item.category}" style="position:static; display:inline-flex; margin-bottom:0.75rem; font-size:0.85rem; padding:0.4rem 1rem;">
                ${item.categoryName}
              </span>
              <h1 class="hero-title" style="font-size:2rem; margin-bottom:0.5rem;">${item.title}</h1>
              <div style="font-size:0.9rem; color:var(--text-muted); display:flex; gap:1.25rem; flex-wrap:wrap; margin-top:0.5rem;">
                <span>👤 選手：<strong style="color:var(--text-main);">${item.athlete || 'Ericqw'}</strong></span>
                <span>📅 日期：<strong style="color:var(--text-main);">${formattedDate}</strong></span>
                <span>⏱️ 完工時間：<strong style="color:var(--accent-cyan);">${item.completionTime || formattedDate}</strong></span>
                <span>📌 狀態：<strong style="${isInProgress ? 'color:var(--accent-red); font-weight:800;' : 'color:var(--accent-green);'}">${statusTextDisplay}</strong></span>
                <span>🎓 評分：<strong style="color:var(--accent-amber); font-size:1.05rem;">${teacherScoreText}</strong></span>
                <span>📷 照片：<strong style="color:var(--accent-blue);">${photoList.length} 張照片</strong></span>
                <span>👨‍💻 程式碼：<strong style="color:var(--accent-green);">${snippets.length} 段程式碼</strong></span>
              </div>
            </div>
            <div>
              <button class="btn btn-gold" id="fullPageEditBtn" data-id="${item.id}" style="padding:0.6rem 1.5rem; font-size:0.95rem;">
                🎓 打分 / 編輯程式碼標題 / 編輯內容
              </button>
            </div>
          </div>
        </div>

        <!-- 緊湊雙欄區塊 -->
        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap:1.5rem; margin-bottom:1.5rem;">
          
          <!-- 左欄：影音與多圖照片藝廊 -->
          <div style="display:flex; flex-direction:column; gap:1.5rem;">
            ${embedVideoUrl ? `
              <div class="hero-banner" style="padding:1.25rem;">
                <h3 style="color:var(--accent-amber); margin-bottom:0.75rem; font-size:1.1rem; display:flex; align-items:center; gap:0.5rem;">
                  <span>🎬</span> YouTube 展示影片
                </h3>
                <div class="video-container" style="margin-bottom:0;">
                  <iframe src="${embedVideoUrl}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
              </div>
            ` : ''}

            ${photoGalleryHtml}
          </div>

          <!-- 右欄：技術簡述、心得與老師打分評語 -->
          <div style="display:flex; flex-direction:column; gap:1.5rem;">
            <div class="hero-banner" style="padding:1.25rem;">
              <h3 style="color:var(--accent-cyan); margin-bottom:0.75rem; font-size:1.1rem;">📌 作品架構與技術重點簡述</h3>
              <p style="color:var(--text-main); font-size:0.95rem; line-height:1.7; white-space:pre-line;">${item.description}</p>
            </div>

            ${item.reflections ? `
              <div class="hero-banner" style="padding:1.25rem; border-left:4px solid var(--accent-cyan);">
                <h3 style="color:var(--accent-cyan); margin-bottom:0.75rem; font-size:1.1rem;">💭 練習心得與檢討報告</h3>
                <p style="color:var(--text-main); font-size:0.92rem; line-height:1.65; white-space:pre-line;">${item.reflections}</p>
              </div>
            ` : ''}

            <!-- 🎓 指導老師打分與評語重點展示 -->
            <div class="hero-banner" style="padding:1.25rem; border-left:4px solid var(--accent-purple); background:rgba(157, 78, 221, 0.08);">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
                <h3 style="color:var(--accent-purple); font-size:1.1rem;">💬 指導老師評分與評語</h3>
                <span style="background:var(--accent-purple); color:#fff; font-weight:800; padding:0.2rem 0.75rem; border-radius:var(--radius-full); font-size:0.9rem;">
                  ${teacherScoreText}
                </span>
              </div>
              <p style="color:var(--text-main); font-size:0.95rem; line-height:1.6;">${item.feedback || '尚未填寫指導老師評語。點擊右上角「打分 / 編輯程式碼標題 / 編輯內容」即可打分並寫入試算表！'}</p>
            </div>

            ${item.rubric ? `
              <div class="hero-banner" style="padding:1.25rem; border-left:4px solid var(--accent-amber);">
                <h3 style="color:var(--accent-amber); margin-bottom:0.75rem; font-size:1.1rem;">🎯 評分與驗收標準明細</h3>
                <p style="color:var(--text-main); font-size:0.92rem;">${item.rubric}</p>
              </div>
            ` : ''}

            <div class="hero-banner" style="padding:1.25rem;">
              <h4 style="color:var(--text-muted); margin-bottom:0.5rem; font-size:0.88rem;">🏷️ 關鍵字標籤</h4>
              <div class="tags-container">
                ${(item.tags || []).map(t => `<span class="tag-pill">#${t}</span>`).join('')}
              </div>
            </div>
          </div>

        </div>

        <!-- 滿版底部區塊：多段程式碼檢視器 -->
        ${multiCodeBlockHtml}

      </div>
    `;

                // 多段程式碼頁籤點擊與高亮渲染、複製事件綁定
                if (snippets.length > 0) {
                    let activeSnippetIndex = 0;
                    const tabNav = container.querySelector('#detailCodeTabNav');
                    const codeBox = container.querySelector('#detailCodeBlock');
                    const copyBtn = container.querySelector('#copyActiveCodeBtn');

                    function renderActiveSnippet(idx) {
                        const raw = snippets[idx].code || '';
                        const formatted = window.formatCStyleCode ? window.formatCStyleCode(raw) : raw;
                        if (window.highlightCCode) {
                            codeBox.innerHTML = `<code>${window.highlightCCode(formatted)}</code>`;
                        } else {
                            codeBox.textContent = formatted;
                        }
                    }

                    if (codeBox) {
                        renderActiveSnippet(0);
                    }

                    if (tabNav && codeBox) {
                        const tabBtns = tabNav.querySelectorAll('.code-tab-btn');
                        tabBtns.forEach(btn => {
                            btn.addEventListener('click', () => {
                                tabBtns.forEach(b => b.classList.remove('active'));
                                btn.classList.add('active');
                                activeSnippetIndex = Number(btn.getAttribute('data-index'));
                                renderActiveSnippet(activeSnippetIndex);
                            });
                        });
                    }

                    if (copyBtn && codeBox) {
                        copyBtn.addEventListener('click', () => {
                            const raw = snippets[activeSnippetIndex].code || '';
                            const textToCopy = window.formatCStyleCode ? window.formatCStyleCode(raw) : raw;
                            navigator.clipboard.writeText(textToCopy);
                            copyBtn.innerHTML = '✔️ 已複製至剪貼簿！';
                            copyBtn.style.color = '#10b981';
                            copyBtn.style.borderColor = '#10b981';
                            setTimeout(() => {
                                copyBtn.innerHTML = '📋 複製目前選取程式碼';
                                copyBtn.style.color = '';
                                copyBtn.style.borderColor = '';
                            }, 2000);
                            showToast(`📋 已複製「${snippets[activeSnippetIndex].title || '程式碼'}」至剪貼簿！`, 'success');
                        });
                    }
                }

                const fullPageEditBtn = container.querySelector('#fullPageEditBtn');
                if (fullPageEditBtn) {
                    fullPageEditBtn.addEventListener('click', () => openEditModal(item.id));
                }

                switchTab('projectDetail');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            /* ==========================================================================
               5. 上傳與編輯中心 (動態多段程式碼與自訂標題編輯器 Engine)
               ========================================================================== */
            function renderCodeSnippetsEditor(containerEl, snippetsArray) {
                if (!containerEl) return;
                containerEl.innerHTML = '';

                if (!snippetsArray || snippetsArray.length === 0) {
                    containerEl.innerHTML = '<div style="color:var(--text-muted); font-size:0.85rem; padding:0.5rem 0;">目前尚未新增程式碼區塊。點擊下方「➕ 新增一段程式碼」即可加入！</div>';
                    return;
                }

                snippetsArray.forEach((item, idx) => {
                    const card = document.createElement('div');
                    card.className = 'snippet-item-card';
                    card.innerHTML = `
        <div class="snippet-item-header">
          <span style="font-weight:700; color:var(--accent-green); font-size:0.88rem;">程式碼 #${idx + 1} 標題：</span>
          <input type="text" class="snippet-title-input" value="${item.title || (`程式碼片段 #${idx + 1}`)}" placeholder="自訂程式碼標題 (例如：TIM3 1ms 中斷常式)">
          <div style="display:flex; gap:0.4rem;">
            <button type="button" class="snippet-format-btn" data-index="${idx}" style="background:rgba(0, 242, 254, 0.15); border:1px solid var(--accent-cyan); color:var(--accent-cyan); font-size:0.8rem; padding:0.35rem 0.75rem; border-radius:var(--radius-sm); cursor:pointer; font-weight:600;">🧹 自動格式化</button>
            <button type="button" class="snippet-delete-btn" data-index="${idx}">🗑️ 刪除此段</button>
          </div>
        </div>
        <textarea class="snippet-code-textarea" placeholder="貼上 STM32 C/C++ 程式碼內容...">${item.code || ''}</textarea>
      `;

                    const titleInput = card.querySelector('.snippet-title-input');
                    const codeTextarea = card.querySelector('.snippet-code-textarea');
                    const formatBtn = card.querySelector('.snippet-format-btn');
                    const deleteBtn = card.querySelector('.snippet-delete-btn');

                    titleInput.addEventListener('input', (e) => {
                        snippetsArray[idx].title = e.target.value;
                    });

                    codeTextarea.addEventListener('input', (e) => {
                        snippetsArray[idx].code = e.target.value;
                    });

                    formatBtn.addEventListener('click', () => {
                        const formatted = window.formatCStyleCode ? window.formatCStyleCode(codeTextarea.value) : codeTextarea.value;
                        codeTextarea.value = formatted;
                        snippetsArray[idx].code = formatted;
                        showToast('🧹 已自動完成 C/C++ 程式碼分行與縮排排版！', 'success');
                    });

                    deleteBtn.addEventListener('click', () => {
                        snippetsArray.splice(idx, 1);
                        renderCodeSnippetsEditor(containerEl, snippetsArray);
                    });

                    containerEl.appendChild(card);
                });
            }

            function initUploadForm() {
                const form = document.getElementById('recordUploadForm');
                const imageInput = document.getElementById('uploadImageFile');
                const openPickerBtn = document.getElementById('openUploadPickerBtn');
                const previewContainer = document.getElementById('uploadImagePreviewContainer');

                const snippetsContainer = document.getElementById('uploadSnippetsContainer');
                const addSnippetBtn = document.getElementById('addUploadSnippetBtn');

                uploadedDataUris = [];
                uploadCodeSnippets = [{ title: '1. 主程式與核心演算法', code: '' }];

                if (snippetsContainer) {
                    renderCodeSnippetsEditor(snippetsContainer, uploadCodeSnippets);
                }

                if (addSnippetBtn && snippetsContainer) {
                    addSnippetBtn.addEventListener('click', () => {
                        const nextNum = uploadCodeSnippets.length + 1;
                        uploadCodeSnippets.push({ title: `${nextNum}. 新程式碼區塊`, code: '' });
                        renderCodeSnippetsEditor(snippetsContainer, uploadCodeSnippets);
                    });
                }

                const handleFilesProcessing = async (files) => {
                    if (!files || files.length === 0) return;
                    if (previewContainer) {
                        previewContainer.innerHTML = '<div style="color:var(--accent-cyan); font-size:0.88rem; width:100%; text-align:center; padding:0.5rem;">⚡ 正在優化與自動壓縮本機圖片中...</div>';
                    }

                    uploadedDataUris = [];
                    for (let i = 0; i < files.length; i++) {
                        const file = files[i];
                        if (file.type.startsWith('image/')) {
                            const compressedUri = await window.compressImageFile(file, 900, 900, 0.75);
                            if (compressedUri) {
                                uploadedDataUris.push(compressedUri);
                            }
                        }
                    }

                    renderUploadPreviewThumbnails();
                };

                function renderUploadPreviewThumbnails() {
                    if (!previewContainer) return;
                    previewContainer.innerHTML = '';
                    uploadedDataUris.forEach((uri, idx) => {
                        const imgEl = document.createElement('img');
                        imgEl.src = uri;
                        imgEl.className = 'preview-thumbnail';
                        imgEl.style.width = '110px';
                        imgEl.style.height = '85px';
                        imgEl.style.objectFit = 'cover';
                        imgEl.style.borderRadius = '8px';
                        imgEl.style.border = '1px solid var(--border-color)';
                        previewContainer.appendChild(imgEl);
                    });
                }

                if (openPickerBtn) {
                    openPickerBtn.addEventListener('click', () => openDrivePickerModal('upload'));
                }

                if (imageInput) {
                    imageInput.addEventListener('change', async (e) => {
                        const files = Array.from(e.target.files);
                        await handleFilesProcessing(files);
                    });
                }

                if (form) {
                    form.addEventListener('submit', (e) => {
                        e.preventDefault();

                        const title = document.getElementById('uploadTitle').value.trim();
                        const category = document.getElementById('uploadCategory').value;
                        const status = document.getElementById('uploadStatus') ? document.getElementById('uploadStatus').value : '已完工';
                        const date = document.getElementById('uploadDate').value || new Date().toISOString().slice(0, 10);
                        const completionTime = document.getElementById('uploadCompletionTime').value.trim() || `${date} (${status})`;
                        const athlete = 'Ericqw';
                        const youtubeUrl = document.getElementById('uploadYoutubeUrl').value.trim();
                        const description = document.getElementById('uploadDescription').value.trim();
                        const rubric = document.getElementById('uploadRubric').value.trim();
                        const score = document.getElementById('uploadScore') ? document.getElementById('uploadScore').value.trim() : '';
                        const reflections = document.getElementById('uploadReflections').value.trim();
                        const feedback = document.getElementById('uploadFeedback').value.trim();
                        const tagsRaw = document.getElementById('uploadTags').value.trim();
                        const urlInputRaw = document.getElementById('uploadImageUrls') ? document.getElementById('uploadImageUrls').value.trim() : '';

                        let imagesList = [...uploadedDataUris];
                        if (urlInputRaw) {
                            const parsedUrls = convertGoogleDriveImageUrl(urlInputRaw);
                            imagesList = imagesList.concat(parsedUrls);
                        }

                        const validSnippets = uploadCodeSnippets.filter(s => s && (s.title.trim() || s.code.trim()));

                        const categoryName = category === 'soldering' ? '焊接作品' : 'STM32作品';
                        const tags = tagsRaw ? tagsRaw.split(',').map(t => t.trim()) : [categoryName, status];

                        const newRecord = {
                            title,
                            category,
                            categoryName,
                            status,
                            date,
                            completionTime,
                            athlete,
                            youtubeUrl,
                            description,
                            rubric,
                            score,
                            reflections,
                            feedback,
                            codeSnippets: validSnippets,
                            codeSnippet: validSnippets.length > 0 ? JSON.stringify(validSnippets) : '',
                            image: imagesList.length > 0 ? imagesList[0] : '',
                            images: imagesList,
                            tags
                        };

                        DataManager.addRecord(newRecord);
                        showToast(`🎉 成功發佈 ${imagesList.length} 張照片與 ${validSnippets.length} 段程式碼！`, 'success');

                        form.reset();
                        uploadedDataUris = [];
                        uploadCodeSnippets = [{ title: '1. 主程式與核心演算法', code: '' }];
                        if (previewContainer) previewContainer.innerHTML = '';
                        if (snippetsContainer) renderCodeSnippetsEditor(snippetsContainer, uploadCodeSnippets);

                        renderDashboard();
                        switchTab('projects', category);
                    });
                }
            }

            function initEditForm() {
                const editForm = document.getElementById('recordEditForm');
                const openEditPickerBtn = document.getElementById('openEditPickerBtn');
                const editImageInput = document.getElementById('editImageFile');
                const editPreviewContainer = document.getElementById('editImagePreviewContainer');

                const snippetsContainer = document.getElementById('editSnippetsContainer');
                const addSnippetBtn = document.getElementById('addEditSnippetBtn');

                editUploadedDataUris = [];

                if (addSnippetBtn && snippetsContainer) {
                    addSnippetBtn.addEventListener('click', () => {
                        const nextNum = editCodeSnippets.length + 1;
                        editCodeSnippets.push({ title: `${nextNum}. 新程式碼區塊`, code: '' });
                        renderCodeSnippetsEditor(snippetsContainer, editCodeSnippets);
                    });
                }

                const handleEditFilesProcessing = async (files) => {
                    if (!files || files.length === 0) return;
                    if (editPreviewContainer) {
                        editPreviewContainer.innerHTML = '<div style="color:var(--accent-cyan); font-size:0.88rem; width:100%; text-align:center; padding:0.5rem;">⚡ 正在優化壓縮圖片中...</div>';
                    }

                    for (let i = 0; i < files.length; i++) {
                        const file = files[i];
                        if (file.type.startsWith('image/')) {
                            const compressedUri = await window.compressImageFile(file, 900, 900, 0.75);
                            if (compressedUri) {
                                editUploadedDataUris.push(compressedUri);
                            }
                        }
                    }

                    renderEditPreviewThumbnails();
                };

                function renderEditPreviewThumbnails() {
                    if (!editPreviewContainer) return;
                    editPreviewContainer.innerHTML = '';
                    editUploadedDataUris.forEach((uri, idx) => {
                        const imgEl = document.createElement('img');
                        imgEl.src = uri;
                        imgEl.className = 'preview-thumbnail';
                        imgEl.style.width = '90px';
                        imgEl.style.height = '70px';
                        imgEl.style.objectFit = 'cover';
                        imgEl.style.borderRadius = '6px';
                        imgEl.style.border = '1px solid var(--border-color)';
                        editPreviewContainer.appendChild(imgEl);
                    });
                }

                if (openEditPickerBtn) {
                    openEditPickerBtn.addEventListener('click', () => openDrivePickerModal('edit'));
                }

                if (editImageInput) {
                    editImageInput.addEventListener('change', async (e) => {
                        const files = Array.from(e.target.files);
                        await handleEditFilesProcessing(files);
                    });
                }

                if (editForm) {
                    editForm.addEventListener('submit', (e) => {
                        e.preventDefault();
                        const id = document.getElementById('editRecordId').value;
                        const title = document.getElementById('editTitle').value.trim();
                        const category = document.getElementById('editCategory').value;
                        const status = document.getElementById('editStatus') ? document.getElementById('editStatus').value : '已完工';
                        const date = document.getElementById('editDate').value;
                        const completionTime = document.getElementById('editCompletionTime').value.trim();
                        const rawImagesText = document.getElementById('editImage') ? document.getElementById('editImage').value.trim() : '';
                        const youtubeUrl = document.getElementById('editYoutubeUrl').value.trim();
                        const description = document.getElementById('editDescription').value.trim();
                        const rubric = document.getElementById('editRubric').value.trim();
                        const score = document.getElementById('editScore') ? document.getElementById('editScore').value.trim() : '';
                        const reflections = document.getElementById('editReflections').value.trim();
                        const feedback = document.getElementById('editFeedback').value.trim();

                        const categoryName = category === 'soldering' ? '焊接作品' : 'STM32作品';

                        let allImagesList = [...editUploadedDataUris];
                        if (rawImagesText) {
                            const textUrls = convertGoogleDriveImageUrl(rawImagesText);
                            allImagesList = allImagesList.concat(textUrls);
                        }

                        const validSnippets = editCodeSnippets.filter(s => s && (s.title.trim() || s.code.trim()));

                        const updateFields = {
                            title,
                            category,
                            categoryName,
                            status,
                            date,
                            completionTime,
                            youtubeUrl,
                            description,
                            rubric,
                            score,
                            reflections,
                            feedback,
                            codeSnippets: validSnippets,
                            codeSnippet: validSnippets.length > 0 ? JSON.stringify(validSnippets) : '',
                            image: allImagesList.length > 0 ? allImagesList[0] : '',
                            images: allImagesList
                        };

                        DataManager.updateRecord(id, updateFields);

                        document.getElementById('editModalOverlay').classList.remove('active');
                        showToast('✏️ 已更新作品資料、狀態亮燈與多段程式碼！', 'success');
                        renderDashboard();
                        renderProjectGrid();

                        const detailView = document.getElementById('projectDetailView');
                        if (detailView && detailView.classList.contains('active')) {
                            openFullPageDetail(id);
                        }
                    });
                }
            }

            function openEditModal(id) {
                const records = DataManager.getRecords();
                const item = records.find(r => r.id === id);
                if (!item) return;

                editUploadedDataUris = [];
                const editPreviewContainer = document.getElementById('editImagePreviewContainer');
                if (editPreviewContainer) editPreviewContainer.innerHTML = '';

                document.getElementById('editRecordId').value = item.id;
                document.getElementById('editTitle').value = item.title || '';
                document.getElementById('editCategory').value = item.category || 'soldering';
                if (document.getElementById('editStatus')) document.getElementById('editStatus').value = item.status || '已完工';
                document.getElementById('editDate').value = item.date || '';
                document.getElementById('editCompletionTime').value = item.completionTime || '';
                if (document.getElementById('editImage')) {
                    const allImgs = (item.images && item.images.length > 0) ? item.images.join(',\n') : (item.image || '');
                    document.getElementById('editImage').value = allImgs;
                }
                document.getElementById('editYoutubeUrl').value = item.youtubeUrl || '';
                document.getElementById('editDescription').value = item.description || '';
                document.getElementById('editRubric').value = item.rubric || '';
                if (document.getElementById('editScore')) document.getElementById('editScore').value = item.score || '';
                document.getElementById('editReflections').value = item.reflections || '';
                document.getElementById('editFeedback').value = item.feedback || '';

                // 初始化多段程式碼編輯器 (Code Snippets Editor)
                const snippets = window.getRecordCodeSnippets ? window.getRecordCodeSnippets(item) : [];
                editCodeSnippets = JSON.parse(JSON.stringify(snippets));
                if (editCodeSnippets.length === 0) {
                    editCodeSnippets = [{ title: '1. 主程式與核心演算法', code: '' }];
                }
                const editSnippetsContainer = document.getElementById('editSnippetsContainer');
                if (editSnippetsContainer) {
                    renderCodeSnippetsEditor(editSnippetsContainer, editCodeSnippets);
                }

                const overlay = document.getElementById('editModalOverlay');
                if (overlay) overlay.classList.add('active');
            }

            /* ==========================================================================
               6. 🎯 Google Sites 風格選取圖片 Modal (Google Drive Image Picker Dialog)
               ========================================================================== */
            function initDrivePickerModal() {
                const overlay = document.getElementById('drivePickerModalOverlay');
                const closeBtn = document.getElementById('pickerCloseBtn');
                const cancelBtn = document.getElementById('pickerCancelBtn');
                const confirmBtn = document.getElementById('pickerConfirmBtn');
                const gridContainer = document.getElementById('pickerPhotoGrid');
                const pickerFileInput = document.getElementById('pickerLocalFileInput');

                if (closeBtn && overlay) closeBtn.addEventListener('click', () => overlay.classList.remove('active'));
                if (cancelBtn && overlay) cancelBtn.addEventListener('click', () => overlay.classList.remove('active'));

                const tabDrive = document.getElementById('pickerTabDrive');
                const tabLink = document.getElementById('pickerTabLink');
                const tabLocal = document.getElementById('pickerTabLocal');

                const viewDrive = document.getElementById('pickerViewDrive');
                const viewLink = document.getElementById('pickerViewLink');
                const viewLocal = document.getElementById('pickerViewLocal');

                if (tabDrive && tabLink && tabLocal) {
                    tabDrive.addEventListener('click', () => {
                        tabDrive.classList.add('active'); tabLink.classList.remove('active'); tabLocal.classList.remove('active');
                        viewDrive.style.display = 'block'; viewLink.style.display = 'none'; viewLocal.style.display = 'none';
                    });

                    tabLink.addEventListener('click', () => {
                        tabLink.classList.add('active'); tabDrive.classList.remove('active'); tabLocal.classList.remove('active');
                        viewLink.style.display = 'block'; viewDrive.style.display = 'none'; viewLocal.style.display = 'none';
                    });

                    tabLocal.addEventListener('click', () => {
                        tabLocal.classList.add('active'); tabDrive.classList.remove('active'); tabLink.classList.remove('active');
                        viewLocal.style.display = 'block'; viewDrive.style.display = 'none'; viewLocal.style.display = 'none';
                    });
                }

                if (pickerFileInput) {
                    pickerFileInput.addEventListener('change', async (e) => {
                        const files = Array.from(e.target.files);
                        for (let i = 0; i < files.length; i++) {
                            const compressed = await window.compressImageFile(files[i], 900, 900, 0.75);
                            if (compressed) selectedDrivePhotos.push(compressed);
                        }
                        showToast(`已成功處理選取之 ${files.length} 張照片！`, 'success');
                    });
                }

                if (confirmBtn) {
                    confirmBtn.addEventListener('click', () => {
                        const linkInput = document.getElementById('pickerLinkTextarea');
                        if (linkInput && linkInput.value.trim()) {
                            const links = convertGoogleDriveImageUrl(linkInput.value.trim());
                            selectedDrivePhotos = selectedDrivePhotos.concat(links);
                        }

                        if (selectedDrivePhotos.length === 0) {
                            showToast('⚠️ 請先勾選或上傳照片', 'error');
                            return;
                        }

                        if (activePickerTarget === 'upload') {
                            uploadedDataUris = uploadedDataUris.concat(selectedDrivePhotos);
                            const uploadPreview = document.getElementById('uploadImagePreviewContainer');
                            if (uploadPreview) {
                                uploadPreview.innerHTML = '';
                                uploadedDataUris.forEach(uri => {
                                    const img = document.createElement('img');
                                    img.src = uri; img.className = 'preview-thumbnail';
                                    img.style.width = '110px'; img.style.height = '85px'; img.style.objectFit = 'cover'; img.style.borderRadius = '8px';
                                    uploadPreview.appendChild(img);
                                });
                            }
                        } else {
                            editUploadedDataUris = editUploadedDataUris.concat(selectedDrivePhotos);
                            const editPreview = document.getElementById('editImagePreviewContainer');
                            if (editPreview) {
                                editPreview.innerHTML = '';
                                editUploadedDataUris.forEach(uri => {
                                    const img = document.createElement('img');
                                    img.src = uri; img.className = 'preview-thumbnail';
                                    img.style.width = '90px'; img.style.height = '70px'; img.style.objectFit = 'cover'; img.style.borderRadius = '6px';
                                    editPreview.appendChild(img);
                                });
                            }
                        }

                        overlay.classList.remove('active');
                        showToast(`✅ 已插入 ${selectedDrivePhotos.length} 張相片！`, 'success');
                    });
                }
            }

            function openDrivePickerModal(targetType = 'upload') {
                activePickerTarget = targetType;
                selectedDrivePhotos = [];

                const overlay = document.getElementById('drivePickerModalOverlay');
                const gridContainer = document.getElementById('pickerPhotoGrid');
                if (!overlay || !gridContainer) return;

                gridContainer.innerHTML = GOOGLE_DRIVE_SAMPLE_PHOTOS.map((photo, idx) => `
      <div class="drive-photo-card" data-url="${photo.url}" data-idx="${idx}">
        <img src="${photo.url}" alt="${photo.name}" class="drive-photo-img" onerror="var m=this.src.match(/\\/d\\/([a-zA-Z0-9_-]+)/); if(m) this.src='https://drive.google.com/thumbnail?id='+m[1]+'&sz=w1000'; else this.src=window.SVG_SOLDERING_HERO;">
        <div class="drive-photo-name" title="${photo.name}">${photo.name}</div>
      </div>
    `).join('');

                gridContainer.querySelectorAll('.drive-photo-card').forEach(card => {
                    card.addEventListener('click', () => {
                        card.classList.toggle('selected');
                        const url = card.getAttribute('data-url');
                        if (card.classList.contains('selected')) {
                            if (!selectedDrivePhotos.includes(url)) selectedDrivePhotos.push(url);
                        } else {
                            selectedDrivePhotos = selectedDrivePhotos.filter(u => u !== url);
                        }
                    });
                });

                overlay.classList.add('active');
            }

            /* ==========================================================================
               7. Google 帳號驗證與登入機制 (Google OAuth / Auth Controller)
               ========================================================================== */
            function initGoogleAuth() {
                const authBtn = document.getElementById('googleAuthBtn');
                const loginModal = document.getElementById('googleLoginModalOverlay');
                const loginClose = document.getElementById('googleLoginModalClose');
                const loginActionBtn = document.getElementById('doGoogleLoginBtn');
                const userBadgeContainer = document.getElementById('googleUserBadgeContainer');

                const updateAuthUI = () => {
                    const savedUserJson = localStorage.getItem('ericqw_google_user');
                    if (savedUserJson) {
                        const user = JSON.parse(savedUserJson);
                        if (userBadgeContainer) {
                            userBadgeContainer.innerHTML = `
            <div class="user-google-badge">
              <span>🟢</span>
              <span>${user.email || 'Ericqw (Google已登入)'}</span>
              <button id="logoutGoogleBtn" style="background:transparent; border:none; color:var(--accent-red); cursor:pointer; font-size:0.8rem; margin-left:0.4rem;">[登出]</button>
            </div>
          `;
                            document.getElementById('logoutGoogleBtn').addEventListener('click', () => {
                                localStorage.removeItem('ericqw_google_user');
                                showToast('已登出 Google 帳號', 'success');
                                updateAuthUI();
                            });
                        }
                        if (authBtn) authBtn.style.display = 'none';
                    } else {
                        if (userBadgeContainer) userBadgeContainer.innerHTML = '';
                        if (authBtn) {
                            authBtn.style.display = 'inline-flex';
                            authBtn.innerHTML = '🔑 登入 Google 帳號';
                        }
                    }
                };

                updateAuthUI();

                if (authBtn && loginModal) {
                    authBtn.addEventListener('click', () => loginModal.classList.add('active'));
                }

                if (loginClose && loginModal) {
                    loginClose.addEventListener('click', () => loginModal.classList.remove('active'));
                }

                if (loginActionBtn) {
                    loginActionBtn.addEventListener('click', () => {
                        const emailInput = document.getElementById('googleAccountEmailInput');
                        const email = (emailInput && emailInput.value.trim()) ? emailInput.value.trim() : 'ericqw@gmail.com';

                        const googleUser = {
                            name: 'Ericqw 選手',
                            email: email,
                            loginTime: new Date().toISOString()
                        };

                        localStorage.setItem('ericqw_google_user', JSON.stringify(googleUser));
                        if (loginModal) loginModal.classList.remove('active');
                        showToast(`✅ 已成功驗證登入 Google 帳號 (${email})！`, 'success');
                        updateAuthUI();
                    });
                }
            }

            function initModalListeners() {
                const codeClose = document.getElementById('codeModalClose');
                const editClose = document.getElementById('editModalClose');
                const googleModalClose = document.getElementById('googleModalClose');

                const codeOverlay = document.getElementById('codeModalOverlay');
                const editOverlay = document.getElementById('editModalOverlay');
                const googleOverlay = document.getElementById('googleModalOverlay');

                if (codeClose && codeOverlay) {
                    codeClose.addEventListener('click', () => codeOverlay.classList.remove('active'));
                    codeOverlay.addEventListener('click', (e) => { if (e.target === codeOverlay) codeOverlay.classList.remove('active'); });
                }

                if (editClose && editOverlay) {
                    editClose.addEventListener('click', () => editOverlay.classList.remove('active'));
                    editOverlay.addEventListener('click', (e) => { if (e.target === editOverlay) editOverlay.classList.remove('active'); });
                }

                if (googleModalClose && googleOverlay) {
                    googleModalClose.addEventListener('click', () => googleModalClose.classList.remove('active'));
                    googleOverlay.addEventListener('click', (e) => { if (e.target === googleOverlay) googleOverlay.classList.remove('active'); });
                }
            }

            function openCodeModal(id) {
                const records = DataManager.getRecords();
                const item = records.find(r => r.id === id);
                if (!item) return;

                const snippets = window.getRecordCodeSnippets ? window.getRecordCodeSnippets(item) : [];
                if (snippets.length === 0) return;

                const overlay = document.getElementById('codeModalOverlay');
                const title = document.getElementById('codeModalTitle');
                const container = document.getElementById('codeModalSnippet');

                if (title) title.textContent = `👨‍💻 ${item.title} - 程式碼片段與演算法 (${snippets.length} 段)`;

                if (container) {
                    if (snippets.length === 1) {
                        const formattedCode = window.formatCStyleCode ? window.formatCStyleCode(snippets[0].code || '') : (snippets[0].code || '');
                        container.innerHTML = `
          <div style="margin-bottom:0.5rem; font-weight:700; color:var(--accent-green);">${snippets[0].title || '核心邏輯'}</div>
          <pre class="code-block" style="white-space:pre-wrap; word-wrap:break-word; font-family:'JetBrains Mono', monospace; font-size:0.88rem; line-height:1.65;"><code>${formattedCode}</code></pre>
        `;
                    } else {
                        const tabsHtml = snippets.map((s, idx) => `
          <button class="code-tab-btn ${idx === 0 ? 'active' : ''}" data-index="${idx}">
            ${s.title || (`程式碼 #${idx + 1}`)}
          </button>
        `).join('');

                        const firstFormattedCode = window.formatCStyleCode ? window.formatCStyleCode(snippets[0].code || '') : (snippets[0].code || '');

                        container.innerHTML = `
          <div class="code-tab-nav" id="modalCodeTabNav">
            ${tabsHtml}
          </div>
          <pre class="code-block" style="white-space:pre-wrap; word-wrap:break-word; font-family:'JetBrains Mono', monospace; font-size:0.88rem; line-height:1.65; max-height:480px; overflow-x:auto;"><code id="modalCodeContent"></code></pre>
        `;

                        const codeContent = container.querySelector('#modalCodeContent');
                        if (codeContent) codeContent.textContent = firstFormattedCode;

                        const tabNav = container.querySelector('#modalCodeTabNav');
                        if (tabNav && codeContent) {
                            const tabBtns = tabNav.querySelectorAll('.code-tab-btn');
                            tabBtns.forEach(btn => {
                                btn.addEventListener('click', () => {
                                    tabBtns.forEach(b => b.classList.remove('active'));
                                    btn.classList.add('active');
                                    const activeIdx = Number(btn.getAttribute('data-index'));
                                    const targetCode = snippets[activeIdx].code || '';
                                    codeContent.textContent = window.formatCStyleCode ? window.formatCStyleCode(targetCode) : targetCode;
                                });
                            });
                        }
                    }
                }

                if (overlay) overlay.classList.add('active');
            }

            /* ==========================================================================
               8. 學科模擬測驗 Practice Engine (Quiz Module)
               ========================================================================== */
            function initQuizModule() {
                const quizMenuBtns = document.querySelectorAll('.quiz-menu-btn');
                let currentSubjectKey = 'electronics';

                quizMenuBtns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        quizMenuBtns.forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                        currentSubjectKey = btn.getAttribute('data-subject');
                        renderQuizQuestions(currentSubjectKey);
                    });
                });

                renderQuizQuestions(currentSubjectKey);
            }

            function renderQuizQuestions(subjectKey) {
                const container = document.getElementById('quizQuestionsContainer');
                if (!container) return;

                const quizBank = window.QUIZ_BANK || (typeof QUIZ_BANK !== 'undefined' ? QUIZ_BANK : {});
                const questions = quizBank[subjectKey] || [];
                container.innerHTML = questions.map((q, qIndex) => `
      <div class="quiz-card" id="quizCard_${q.id}">
        <div style="font-size:0.8rem; color:var(--accent-purple); font-weight:700; margin-bottom:0.5rem;">
          ${q.subject} 模擬測驗題 ${qIndex + 1}
        </div>
        <h3 class="question-title">${q.question}</h3>
        <div class="options-list">
          ${q.options.map((opt, oIndex) => `
            <div class="option-item" data-qid="${q.id}" data-oindex="${oIndex}">
              ${opt}
            </div>
          `).join('')}
        </div>
        <div class="explanation-box" id="explanation_${q.id}" style="display:none;">
          <strong>💡 解析說明：</strong> ${q.explanation}
        </div>
      </div>
    `).join('');

                container.querySelectorAll('.option-item').forEach(optEl => {
                    optEl.addEventListener('click', () => {
                        const qid = optEl.getAttribute('data-qid');
                        const selectedIndex = Number(optEl.getAttribute('data-oindex'));
                        const qData = questions.find(q => q.id === qid);
                        if (!qData) return;

                        const parentCard = document.getElementById(`quizCard_${qid}`);
                        const allOpts = parentCard.querySelectorAll('.option-item');
                        const expBox = document.getElementById(`explanation_${qid}`);

                        allOpts.forEach((el, idx) => {
                            el.style.pointerEvents = 'none';
                            if (idx === qData.answerIndex) {
                                el.classList.add('correct');
                            } else if (idx === selectedIndex) {
                                el.classList.add('wrong');
                            }
                        });

                        if (expBox) expBox.style.display = 'block';

                        if (selectedIndex === qData.answerIndex) {
                            showToast('🎯 回答正確！加深記憶。', 'success');
                        } else {
                            showToast('❌ 答案不正確，請參考下方解析觀念。', 'error');
                        }
                    });
                });
            }

            /* ==========================================================================
               9. Google 試算表即時同步 (Google Sheets Webhook Sync + 診斷教學)
               ========================================================================== */
            async function initGoogleSync(autoBoot = false) {
                const syncBtn = document.getElementById('triggerGoogleSyncBtn');
                const scriptInput = document.getElementById('googleScriptUrlInput');
                const embedBtn = document.getElementById('showGoogleEmbedCodeBtn');

                const savedUrl = DataManager.getSavedGoogleScriptUrl();
                if (scriptInput && savedUrl) {
                    scriptInput.value = savedUrl;
                }

                const doSync = async (isSilent = false) => {
                    const url = scriptInput ? scriptInput.value.trim() : savedUrl;
                    if (!url) return;
                    if (!isSilent) showToast('🔄 正在從 Google 試算表抓取最新資料...', 'success');

                    const result = await DataManager.syncFromGoogleSheets(url);
                    if (result && result.success) {
                    updateSyncStatus('online', '試算表已同步');
                        showToast(`✅ 已自動抓取並同步 ${result.count} 筆 Google 試算表資料！`, 'success');
                        renderDashboard();
                        renderProjectGrid();
                        renderAnalyticsCharts();
                    } else if (result && result.error === 'PERMISSION_DENIED') {
                    updateSyncStatus('error', '權限受限');
                        if (!isSilent) {
                            showToast(`⚠️ 權限錯誤！請將 Apps Script 存取權限設為「任何人 (Anyone)」。`, 'error');
                            alert('【無法同步教學說明】\n1. 請至 Google Apps Script 編輯器點選右上角「部署」➔「管理部署」。\n2. 點選鉛筆編輯圖示。\n3. 將「誰有存取權限」從「僅限自己」改為「任何人 (Anyone)」。\n4. 點選「部署」更新即可連線同步！');
                        }
                    } else if (result && result.error === 'FETCH_ERROR') {
                        if (!isSilent) {
                            showToast(`⚠️ 同步失敗！請檢查 Web App 網址是否正確。`, 'error');
                        }
                    }
                };

                if (autoBoot) {
                    doSync(false);
                }

                if (syncBtn) {
                    syncBtn.addEventListener('click', () => doSync(false));
                }

                if (embedBtn) {
                    embedBtn.addEventListener('click', () => {
                        const overlay = document.getElementById('googleModalOverlay');
                        const snippetEl = document.getElementById('googleEmbedSnippet');
                        const currentLoc = window.location.href;

                        snippetEl.textContent = `<iframe src="${currentLoc}" width="100%" height="900" style="border:none; border-radius:12px; overflow:hidden;" allowfullscreen></iframe>`;
                        if (overlay) overlay.classList.add('active');
                    });
                }

                const copyEmbedBtn = document.getElementById('copyEmbedSnippetBtn');
                if (copyEmbedBtn) {
                    copyEmbedBtn.addEventListener('click', () => {
                        const snippetEl = document.getElementById('googleEmbedSnippet');
                        navigator.clipboard.writeText(snippetEl.textContent);
                        showToast('📋 已複製 Google 協作平台 HTML 嵌入碼！', 'success');
                    });
                }
            }

            /* ==========================================================================
               10. 🐍 蛇行訓練里程碑進度圖 Engine (Serpentine Snake Timeline Roadmap with Red Active Node)
               ========================================================================== */
            function renderSerpentineTimeline(filter) {
                if (!filter) filter = (typeof currentSnakeFilter !== 'undefined' ? currentSnakeFilter : 'all');
                currentSnakeFilter = filter;
                currentSnakeFilter = filter;
                const wrapper = document.getElementById('snakeTimelineWrapper');
                const svgLayer = document.getElementById('snakeSvgLayer');
                const nodesLayer = document.getElementById('snakeNodesLayer');

                if (!wrapper || !svgLayer || !nodesLayer) return;

                svgLayer.innerHTML = '';
                nodesLayer.innerHTML = '';

                // 按訓練日期由舊至新排序 (Ascending Chronological Order)
                let records = DataManager.getRecords().sort((a, b) => new Date(a.date) - new Date(b.date));
                if (records.length === 0) {
                    wrapper.style.height = '120px';
                    nodesLayer.innerHTML = '<div style="text-align:center; padding:2rem; color:var(--text-muted); font-size:0.9rem;">目前尚未有任何成果紀錄。</div>';
                    return;
                }

                // 依篩選條件過濾
                if (filter === 'in_progress') {
                    records = records.filter(r => r.status === '進行中' || r.status === '訓練中' || r.status === 'in_progress');
                } else if (filter === 'soldering') {
                    records = records.filter(r => r.category === 'soldering');
                } else if (filter === 'stm32') {
                    records = records.filter(r => r.category === 'stm32');
                }

                if (records.length === 0) {
                    wrapper.style.height = '120px';
                    nodesLayer.innerHTML = '<div style="text-align:center; padding:2rem; color:var(--text-muted); font-size:0.9rem;">此篩選條件下目前無符合之成果節點。</div>';
                    return;
                }

                const wrapperWidth = Math.max(wrapper.clientWidth || 850, 750);
                const cols = wrapperWidth < 600 ? 2 : (wrapperWidth < 900 ? 3 : 5);

                const marginLeft = 65;
                const marginRight = 65;
                const marginTop = 50;
                const rowHeight = 155;

                const stepX = (wrapperWidth - marginLeft - marginRight) / (cols - 1);
                const totalRows = Math.ceil(records.length / cols);
                const wrapperHeight = marginTop + (totalRows - 1) * rowHeight + 105;

                wrapper.style.height = `${wrapperHeight}px`;
                svgLayer.setAttribute('viewBox', `0 0 ${wrapperWidth} ${wrapperHeight}`);

                const points = [];
                records.forEach((record, index) => {
                    const row = Math.floor(index / cols);
                    const colInRow = index % cols;
                    const isEvenRow = row % 2 === 0;
                    const col = isEvenRow ? colInRow : (cols - 1 - colInRow);

                    const x = marginLeft + col * stepX;
                    const y = marginTop + row * rowHeight;
                    points.push({ x, y, record, index, row, isEvenRow });
                });

                // 繪製順暢彎曲的蛇行 S-Curve 連接線
                let pathD = '';
                for (let i = 0; i < points.length; i++) {
                    const p = points[i];
                    if (i === 0) {
                        pathD += `M ${p.x} ${p.y}`;
                    } else {
                        const prev = points[i - 1];
                        if (p.row === prev.row) {
                            pathD += ` L ${p.x} ${p.y}`;
                        } else {
                            // 橫跨換行時繪製 180 度圓弧曲線 (Serpentine Curve)
                            const curveRadius = rowHeight * 0.45;
                            const cpX = prev.isEvenRow ? (prev.x + curveRadius) : (prev.x - curveRadius);
                            pathD += ` C ${cpX} ${prev.y}, ${cpX} ${p.y}, ${p.x} ${p.y}`;
                        }
                    }
                }

                svgLayer.innerHTML = `
      <defs>
        <linearGradient id="snakeLineGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#10b981" />
          <stop offset="70%" stop-color="#00f2fe" />
          <stop offset="100%" stop-color="#ef4444" />
        </linearGradient>
        <filter id="glowGreen" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="4" result="blur" />
          <feComposite in="SourceGraphic" in2="blur" operator="over" />
        </filter>
      </defs>
      <path d="${pathD}" fill="none" stroke="url(#snakeLineGrad)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" filter="url(#glowGreen)" />
    `;

                points.forEach(p => {
                    const nodeEl = document.createElement('div');
                    nodeEl.className = 'snake-node-item';
                    nodeEl.style.left = `${p.x}px`;
                    nodeEl.style.top = `${p.y}px`;

                    const isInProgress = p.record.status === '進行中' || p.record.status === '訓練中' || p.record.status === 'in_progress';
                    const circleClass = isInProgress ? 'snake-node-circle status-in-progress' : 'snake-node-circle';
                    const iconText = isInProgress ? '⚡' : '✓';

                    const formattedDate = window.formatDateString ? window.formatDateString(p.record.date) : String(p.record.date).slice(0, 10);
                    const scoreText = p.record.score ? ` (${p.record.score}分)` : (isInProgress ? ' (進行中)' : '');

                    const firstImg = (p.record.images && p.record.images.length > 0) ? p.record.images[0] : (p.record.image || '');
                    const imgHtml = firstImg ? `<img src="${firstImg}" class="snake-tooltip-img" alt="${escapeHTML(p.record.title)}" onerror="this.style.display='none';">` : '';

                    nodeEl.innerHTML = `
        <div class="${circleClass}" title="點擊查看 ${escapeHTML(p.record.title)} (${isInProgress ? '🔥正在進行中' : '已完成'})">${iconText}</div>
        <div class="snake-node-content">
          <div class="snake-node-title" style="${isInProgress ? 'border-color:var(--accent-red); color:#ffdddd; box-shadow:0 0 12px rgba(239,68,68,0.5);' : ''}">${escapeHTML(p.record.title)}${scoreText}</div>
          <div class="snake-node-date" style="${isInProgress ? 'color:var(--accent-red); font-weight:800;' : ''}">${formattedDate} ${isInProgress ? '🔥進行中' : ''}</div>
        </div>
        <div class="snake-node-tooltip">
          ${imgHtml}
          <div class="snake-tooltip-title">${escapeHTML(p.record.title)}</div>
          <div class="snake-tooltip-meta">
            <span>🏷️ 類別：<strong>${escapeHTML(p.record.categoryName || (p.record.category === 'soldering' ? '焊接作品' : 'STM32作品'))}</strong></span>
            <span>⏱️ 完工：${escapeHTML(p.record.completionTime || formattedDate)}</span>
            <span>📌 狀態：<strong style="${isInProgress ? 'color:var(--accent-red);' : 'color:var(--accent-green);'}">${isInProgress ? '🔴 進行中' : '🟢 已完工'}</strong></span>
            ${p.record.score ? `<span>🎓 評分：<strong style="color:var(--accent-amber);">${escapeHTML(p.record.score)} 分</strong></span>` : ''}
          </div>
          <div style="display:flex; gap:0.5rem; margin-top:0.6rem;">
            <button class="btn btn-outline" style="padding:0.25rem 0.6rem; font-size:0.75rem; flex:1; justify-content:center;" onclick="event.stopPropagation(); window.locateCardAndHighlight('${p.record.id}');">
              📍 定位卡片
            </button>
            <button class="btn btn-primary" style="padding:0.25rem 0.6rem; font-size:0.75rem; flex:1; justify-content:center;" onclick="event.stopPropagation(); window.openFullPageDetail('${p.record.id}');">
              🔎 查看詳情
            </button>
          </div>
        </div>
      `;

                    nodeEl.addEventListener('click', () => {
                        openFullPageDetail(p.record.id);
                    });

                    nodesLayer.appendChild(nodeEl);
                });
            }

            // 📍 定位並高亮卡片函式
            function locateCardAndHighlight(id) {
                const item = DataManager.getRecords().find(r => r.id === id);
                if (!item) return;

                // 切換至作品分頁與對應類別
                const targetFilter = item.category === 'soldering' ? 'soldering' : 'stm32';
                switchTab('projects', targetFilter);

                // 等待 DOM 渲染完畢後平滑滾動並加高亮動畫
                setTimeout(() => {
                    const card = document.querySelector(`.project-card[data-id="${id}"]`) || document.getElementById(`projectCard_${id}`);
                    if (card) {
                        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        card.classList.remove('card-highlight-pulse');
                        void card.offsetWidth; // 強制重繪
                        card.classList.add('card-highlight-pulse');
                    } else {
                        openFullPageDetail(id);
                    }
                }, 250);
            }
            window.locateCardAndHighlight = locateCardAndHighlight;

            // 初始化蛇行圖篩選按鈕事件
            function initSnakeFilterButtons() {
                const group = document.getElementById('snakeFilterGroup');
                if (!group) return;
                const btns = group.querySelectorAll('.snake-filter-btn');
                btns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        btns.forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                        const filterVal = btn.getAttribute('data-filter') || 'all';
                        renderSerpentineTimeline(filterVal);
                    });
                });
            }


            /* ==========================================================================
               11. 選手歷程分析與圖表 (Chart.js Analytics + 蛇行訓練進度圖)
               ========================================================================== */
            function renderAnalyticsCharts() {
                renderSerpentineTimeline();

                const radarCtx = document.getElementById('athleteRadarChart');
                if (typeof Chart === 'undefined') return;

                if (radarCtx) {
                    if (radarChartInstance) radarChartInstance.destroy();
                    radarChartInstance = new Chart(radarCtx, {
                        type: 'radar',
                        data: {
                            labels: ['STM32微控制', '電路焊接', '電子理論', '除錯能力', '時間控制', '電路佈線'],
                            datasets: [{
                                label: '綜合能力指標',
                                data: [96, 95, 92, 94, 98, 91],
                                backgroundColor: 'rgba(0, 242, 254, 0.25)',
                                borderColor: '#00f2fe',
                                pointBackgroundColor: '#00f2fe',
                                pointBorderColor: '#fff'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                r: {
                                    angleLines: { color: 'rgba(255, 255, 255, 0.1)' },
                                    grid: { color: 'rgba(255, 255, 255, 0.1)' },
                                    pointLabels: { color: '#f1f5f9', font: { size: 12, weight: 'bold' } },
                                    ticks: { backdropColor: 'transparent', color: '#94a3b8' }
                                }
                            },
                            plugins: {
                                legend: { labels: { color: '#f1f5f9' } }
                            }
                        }
                    });
                }
            }

            /* ==========================================================================
               12. Toast 訊息提示元件
               ========================================================================== */
                        /* ==========================================================================
               13. 💾 資料備份與還原管理 (JSON Backup & Restore Manager)
               ========================================================================== */
            function initBackupManager() {
                const modal = document.getElementById('backupModalOverlay');
                const openBtn = document.getElementById('backupDataBtn');
                const closeBtn = document.getElementById('backupModalClose');
                const exportBtn = document.getElementById('exportJsonBtn');
                const selectFileBtn = document.getElementById('selectJsonFileBtn');
                const fileInput = document.getElementById('importJsonFileInput');
                const statusDiv = document.getElementById('importFileStatus');
                const modeSelect = document.getElementById('importModeSelect');
                const resetBtn = document.getElementById('resetDefaultBtn');

                if (!modal) return;

                if (openBtn) {
                    openBtn.addEventListener('click', () => {
                        modal.classList.add('active');
                        if (statusDiv) statusDiv.textContent = '尚未選取檔案';
                        if (fileInput) fileInput.value = '';
                    });
                }

                if (closeBtn) {
                    closeBtn.addEventListener('click', () => modal.classList.remove('active'));
                }

                modal.addEventListener('click', (e) => {
                    if (e.target === modal) modal.classList.remove('active');
                });

                // 📥 匯出 JSON
                if (exportBtn) {
                    exportBtn.addEventListener('click', () => {
                        const records = DataManager.getRecords();
                        const backupData = {
                            app: 'Ericqw Athlete Training System',
                            version: '1.0',
                            exportedAt: new Date().toISOString(),
                            athlete: 'Ericqw',
                            totalRecords: records.length,
                            records: records,
                            theme: localStorage.getItem('ericqw_theme') || 'dark',
                            googleScriptUrl: DataManager.getSavedGoogleScriptUrl()
                        };

                        const jsonStr = JSON.stringify(backupData, null, 2);
                        const blob = new Blob([jsonStr], { type: 'application/json;charset=utf-8;' });
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        const dateStr = new Date().toISOString().slice(0, 10).replace(/-/g, '');
                        a.href = url;
                        a.download = `Ericqw_選手成果紀錄備份_${dateStr}.json`;
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        URL.revokeObjectURL(url);

                        showToast(`📥 成功匯出 ${records.length} 筆專案紀錄備份檔案！`, 'success');
                    });
                }

                // 📤 匯入 JSON
                if (selectFileBtn && fileInput) {
                    selectFileBtn.addEventListener('click', () => fileInput.click());

                    fileInput.addEventListener('change', (e) => {
                        const file = e.target.files && e.target.files[0];
                        if (!file) return;

                        if (statusDiv) statusDiv.textContent = `已選取：${file.name} (${Math.round(file.size / 1024)} KB)，正在解析...`;

                        const reader = new FileReader();
                        reader.onload = (event) => {
                            try {
                                const parsed = JSON.parse(event.target.result);
                                let importedRecords = [];

                                if (Array.isArray(parsed)) {
                                    importedRecords = parsed;
                                } else if (parsed && Array.isArray(parsed.records)) {
                                    importedRecords = parsed.records;
                                } else {
                                    throw new Error('JSON 格式無效，未找到有效的 records 陣列！');
                                }

                                if (importedRecords.length === 0) {
                                    if (statusDiv) statusDiv.textContent = '⚠️ 備份檔案中無任何作品紀錄！';
                                    showToast('選取的備份檔無有效紀錄！', 'error');
                                    return;
                                }

                                const mode = modeSelect ? modeSelect.value : 'replace';
                                let finalRecords = [];

                                if (mode === 'replace') {
                                    finalRecords = importedRecords;
                                } else {
                                    // 合併模式：保留現有並追加新項目 (以 id 為主)
                                    const existing = DataManager.getRecords();
                                    const existingIds = new Set(existing.map(r => r.id));
                                    const newItems = importedRecords.filter(r => !existingIds.has(r.id));
                                    finalRecords = [...existing, ...newItems];
                                }

                                DataManager.saveRecords(finalRecords);
                                renderDashboard();
                                renderProjectGrid();
                                renderSerpentineTimeline();
                                if (typeof renderAnalyticsCharts === 'function') renderAnalyticsCharts();

                                if (statusDiv) statusDiv.innerHTML = `<span style="color:var(--accent-green);">✔️ 成功匯入 ${importedRecords.length} 筆專案紀錄！</span>`;
                                showToast(`🎉 成功還原備份資料！目前共有 ${finalRecords.length} 筆專案紀錄。`, 'success');

                                setTimeout(() => {
                                    modal.classList.remove('active');
                                }, 1200);

                            } catch (err) {
                                console.error('Import error:', err);
                                if (statusDiv) statusDiv.innerHTML = `<span style="color:var(--accent-red);">❌ 解析失敗：${err.message}</span>`;
                                showToast('JSON 備份檔案解析失敗，請確認檔案格式是否正確。', 'error');
                            }
                        };
                        reader.readAsText(file);
                    });
                }

                // ⚠️ 原廠重設
                if (resetBtn) {
                    resetBtn.addEventListener('click', () => {
                        if (confirm('確定要清除所有自訂紀錄，並重設為系統原廠預設的示範紀錄嗎？此操作無法復原。')) {
                            DataManager.resetToDefault();
                            renderDashboard();
                            renderProjectGrid();
                            renderSerpentineTimeline();
                            if (typeof renderAnalyticsCharts === 'function') renderAnalyticsCharts();
                            modal.classList.remove('active');
                            showToast('已重設為原廠預設紀錄！', 'success');
                        }
                    });
                }
            }

            /* ==========================================================================
               14. 📄 列印與匯出 PDF 成果報告書 (Print / Export PDF Controller)
               ========================================================================== */
            function initPrintReport() {
                const printBtn = document.getElementById('printReportBtn');
                if (!printBtn) return;

                printBtn.addEventListener('click', () => {
                    const dateSpan = document.getElementById('printDateSpan');
                    if (dateSpan) {
                        const now = new Date();
                        dateSpan.textContent = `${now.getFullYear()}年${now.getMonth() + 1}月${now.getDate()}日 ${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;
                    }

                    showToast('🖨️ 正在準備列印排版，可於預覽中選擇「另存為 PDF」...', 'success');
                    setTimeout(() => {
                        window.print();
                    }, 350);
                });
            }

            /* ==========================================================================
               15. ⌨️ 全域鍵盤快捷鍵 (Global Shortcuts: Esc, Ctrl+K)
               ========================================================================== */
            function initGlobalShortcuts() {
                document.addEventListener('keydown', (e) => {
                    // Esc: 關閉所有開啟的彈窗
                    if (e.key === 'Escape') {
                        const activeModals = document.querySelectorAll('.modal-overlay.active');
                        activeModals.forEach(m => m.classList.remove('active'));
                    }

                    // Ctrl+K 或 Cmd+K: 快速跳轉至搜尋框
                    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                        e.preventDefault();
                        const searchInput = document.getElementById('globalSearchInput');
                        const tabBtn = document.getElementById('tabBtnSoldering');
                        if (tabBtn) tabBtn.click();
                        if (searchInput) {
                            setTimeout(() => {
                                searchInput.focus();
                                searchInput.select();
                            }, 150);
                        }
                    }
                });

                // 搜尋輸入框加上快速鍵提示
                const searchInput = document.getElementById('globalSearchInput');
                if (searchInput) {
                    searchInput.setAttribute('placeholder', '🔍 搜尋作品名稱、技術標籤、焊接焊點或程式碼... (Ctrl + K)');
                }
            }

            /* ==========================================================================
               16. 🟢 Google 試算表連線狀態小燈號 (Sync Status Badge Controller)
               ========================================================================== */
            function updateSyncStatus(status, text) {
                const dot = document.getElementById('navSyncDot');
                const label = document.getElementById('navSyncText');
                if (!dot || !label) return;
                dot.className = 'sync-dot';
                if (status === 'online') {
                    dot.classList.add('sync-dot-online');
                    label.textContent = text || '試算表已連線';
                } else if (status === 'offline') {
                    dot.classList.add('sync-dot-offline');
                    label.textContent = text || '離線快取模式';
                } else {
                    dot.classList.add('sync-dot-error');
                    label.textContent = text || '權限受限';
                }
            }
            window.updateSyncStatus = updateSyncStatus;

            function showToast(message, type = 'success') {
                const container = document.getElementById('toastContainer');
                if (!container) return;

                const toast = document.createElement('div');
                toast.className = `toast toast-${type}`;
                toast.innerHTML = `
      <span>${type === 'success' ? '✅' : '⚠️'}</span>
      <span>${message}</span>
    `;

                container.appendChild(toast);

                setTimeout(() => {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateX(50px)';
                    setTimeout(() => toast.remove(), 300);
                }, 3000);
            }

            window.showToast = showToast;
            window.openDrivePickerModal = openDrivePickerModal;
            window.renderSerpentineTimeline = renderSerpentineTimeline;
        });


        document.addEventListener('DOMContentLoaded', () => {
            // 🌐 連結官方 Google Drive Picker 呼叫按鈕
            const officialPickerBtn = document.getElementById('launchOfficialGooglePickerBtn');
            if (officialPickerBtn) {
                officialPickerBtn.addEventListener('click', () => {
                    if (window.google && window.google.accounts) {
                        showToast('🌐 正在透過 Google 官方 OAuth 2.0 呼叫 Google Drive 雲端硬碟...', 'success');
                        window.open('https://drive.google.com/', '_blank');
                    } else {
                        window.open('https://drive.google.com/', '_blank');
                    }
                });
            }
        });
    </script>
</body>

</html>